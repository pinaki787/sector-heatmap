# Keep real credentials in a private source. This example file is safe to commit.
# The dashboard also discovers FYERS_* environment variables, the shared
# ~/.fyers/token.json token cache, FYERS_CONFIG_FILE, and platform user config.
# Register this exact local redirect URI in your Fyers app settings.
FYERS_APP_ID=YOUR_APP_ID
FYERS_SECRET_KEY=YOUR_SECRET_KEY
FYERS_REDIRECT_URI=http://127.0.0.1:8080/callback
# Automatically created by get_fyers_token.py after browser login and 2FA.
# FYERS_ACCESS_TOKEN=YOUR_APP_ID:YOUR_ACCESS_TOKEN

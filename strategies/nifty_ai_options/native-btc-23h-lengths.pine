f_origin() =>
    var float firstTime = na
    var float firstAtr = na
    float currentAtr = ta.atr(7)
    if na(firstTime)
        firstTime := time
    if na(firstAtr) and not na(currentAtr)
        firstAtr := currentAtr
    [firstTime,firstAtr,bar_index,time,time_close]
[ft,fa,idx,pt,pe] = request.security(base,"1380",f_origin(),lookahead=barmerge.lookahead_off,calc_bars_count=20000)
plot(ft,"First standard source time")
plot(fa,"First valid source ATR7")
plot(idx,"Standard source index")
plot(pt,"Parent time")
plot(pe,"Parent end")

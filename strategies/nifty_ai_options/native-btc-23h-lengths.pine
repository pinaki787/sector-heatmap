//@version=6
indicator("Sector Pulse BTC 23H Native Length Control", overlay=false)
base = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
[o1,c1,t1] = request.security(ticker.renko(base,"ATR",1,false,"Close"),"1380",[open,close,time],lookahead=barmerge.lookahead_off,calc_bars_count=20000)
a1 = request.security(base,"1380",ta.atr(1),lookahead=barmerge.lookahead_off,calc_bars_count=20000)
plot(math.abs(c1-o1),"Native box 1")
plot(o1,"Native open 1")
plot(c1,"Native close 1")
plot(t1,"Native time 1")
plot(a1,"Ordinary ATR 1")

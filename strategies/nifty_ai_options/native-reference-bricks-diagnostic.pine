//@version=6
indicator("Sector Pulse Native Brick History Diagnostic", overlay=false)
base=ticker.new(syminfo.prefix,syminfo.ticker,session.regular)
native=ticker.renko(base,"ATR",5,false,"Close")
[o0,c0,t0,o1,c1,t1,o2,c2,t2,o3,c3,t3,o4,c4,t4,o5,c5,t5,o6,c6,t6,o7,c7,t7,o8,c8,t8,o9,c9,t9]=request.security(native,"360",[open[0],close[0],time[0],open[1],close[1],time[1],open[2],close[2],time[2],open[3],close[3],time[3],open[4],close[4],time[4],open[5],close[5],time[5],open[6],close[6],time[6],open[7],close[7],time[7],open[8],close[8],time[8],open[9],close[9],time[9]],lookahead=barmerge.lookahead_off)
plot(o0,"Open 0")
plot(c0,"Close 0")
plot(t0,"Time 0")
plot(o1,"Open 1")
plot(c1,"Close 1")
plot(t1,"Time 1")
plot(o2,"Open 2")
plot(c2,"Close 2")
plot(t2,"Time 2")

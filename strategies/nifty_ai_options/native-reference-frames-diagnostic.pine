//@version=6
indicator("Sector Pulse Native Frame Diagnostic",overlay=false)
base=ticker.new(syminfo.prefix,syminfo.ticker,session.regular)
native=ticker.renko(base,"ATR",5,false,"Close")
[o0,c0,t0]=request.security(native,"1",[open,close,time],lookahead=barmerge.lookahead_off)
[a0,pa0,pt0]=request.security(base,"1",[ta.atr(5),ta.atr(5)[1],time],lookahead=barmerge.lookahead_off)
plot(o0,"Native open 1")
plot(c0,"Native close 1")
plot(t0,"Native time 1")
plot(a0,"Ordinary ATR5 1")
plot(pa0,"Prior ordinary ATR5 1")
plot(pt0,"Parent time 1")
[o1,c1,t1]=request.security(native,"5",[open,close,time],lookahead=barmerge.lookahead_off)
[a1,pa1,pt1]=request.security(base,"5",[ta.atr(5),ta.atr(5)[1],time],lookahead=barmerge.lookahead_off)
plot(o1,"Native open 5")
plot(c1,"Native close 5")
plot(t1,"Native time 5")
plot(a1,"Ordinary ATR5 5")
plot(pa1,"Prior ordinary ATR5 5")
plot(pt1,"Parent time 5")
[o2,c2,t2]=request.security(native,"30",[open,close,time],lookahead=barmerge.lookahead_off)
[a2,pa2,pt2]=request.security(base,"30",[ta.atr(5),ta.atr(5)[1],time],lookahead=barmerge.lookahead_off)
plot(o2,"Native open 30")
plot(c2,"Native close 30")
plot(t2,"Native time 30")
plot(a2,"Ordinary ATR5 30")
plot(pa2,"Prior ordinary ATR5 30")
plot(pt2,"Parent time 30")
[o3,c3,t3]=request.security(native,"360",[open,close,time],lookahead=barmerge.lookahead_off)
[a3,pa3,pt3]=request.security(base,"360",[ta.atr(5),ta.atr(5)[1],time],lookahead=barmerge.lookahead_off)
plot(o3,"Native open 360")
plot(c3,"Native close 360")
plot(t3,"Native time 360")
plot(a3,"Ordinary ATR5 360")
plot(pa3,"Prior ordinary ATR5 360")
plot(pt3,"Parent time 360")
[o4,c4,t4]=request.security(native,"1D",[open,close,time],lookahead=barmerge.lookahead_off)
[a4,pa4,pt4]=request.security(base,"1D",[ta.atr(5),ta.atr(5)[1],time],lookahead=barmerge.lookahead_off)
plot(o4,"Native open 1D")
plot(c4,"Native close 1D")
plot(t4,"Native time 1D")
plot(a4,"Ordinary ATR5 1D")
plot(pa4,"Prior ordinary ATR5 1D")

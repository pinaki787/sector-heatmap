//@version=6
indicator("Sector Pulse ETH 23H ATR7 Native Control", overlay=false)
base = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
native = ticker.renko(base, "ATR", 7, false, "Close")
[o,c,t] = request.security(native, "1380", [open,close,time], lookahead=barmerge.lookahead_off, calc_bars_count=20000)
[po,ph,pl,pc,pt,pe,pa] = request.security(base, "1380", [open,high,low,close,time,time_close,ta.atr(7)], lookahead=barmerge.lookahead_off, calc_bars_count=20000)
plot(o,"Native open")
plot(c,"Native close")
plot(t,"Native time")
plot(math.abs(c-o),"Native box")
plot(po,"Parent open")
plot(ph,"Parent high")
plot(pl,"Parent low")
plot(pc,"Parent close")
plot(pt,"Parent time")
plot(pe,"Parent end")
plot(pa,"Ordinary parent ATR7 diagnostic")

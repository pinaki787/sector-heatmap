//@version=6
indicator("Sector Pulse Native Reference Probe", overlay=true)
parent = input.timeframe("360", "Native parent timeframe")
regular = input.bool(true, "Regular trading hours")
base = ticker.new(syminfo.prefix, syminfo.ticker, regular ? session.regular : session.extended)
native = ticker.renko(base, "ATR", 5, false, "Close")
[no, nc, po, pc] = request.security(native, parent, [open, close, open[1], close[1]], lookahead=barmerge.lookahead_off)
box = math.abs(nc-no)
previousBox = math.abs(pc-po)
plot(box, "Native ATR5 box", display=display.status_line + display.data_window, precision=2)
plot(previousBox, "Prior native ATR5 box", display=display.data_window, precision=2)
var table info = table.new(position.top_right, 2, 3, bgcolor=color.rgb(18,35,52))
if barstate.islast
    table.cell(info,0,0,"Native ATR5",text_color=color.white)
    table.cell(info,1,0,str.tostring(box,"0.00"),text_color=color.aqua)
    table.cell(info,0,1,"Prior native box",text_color=color.white)
    table.cell(info,1,1,str.tostring(previousBox,"0.00"),text_color=color.aqua)
    table.cell(info,0,2,"Parent / session",text_color=color.white)
    table.cell(info,1,2,parent + (regular ? " / regular" : " / extended"),text_color=color.aqua)

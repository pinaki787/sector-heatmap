//@version=6
indicator("Sector Pulse Native History Depth Diagnostic",overlay=false)
depth=input.int(300,"Requested context bars",options=[2,20,300,3000,20000])
base=ticker.new(syminfo.prefix,syminfo.ticker,session.regular)
native=ticker.renko(base,"ATR",5,false,"Close")
[no,nc,nt,ni]=request.security(native,"360",[open,close,time,bar_index],lookahead=barmerge.lookahead_off,calc_bars_count=depth)
[atr,pt,pi]=request.security(base,"360",[ta.atr(5),time,bar_index],lookahead=barmerge.lookahead_off,calc_bars_count=depth)
plot(no,"Native open")
plot(nc,"Native close")
plot(nt,"Native time")
plot(ni,"Native context index")
plot(math.abs(nc-no),"Native box")
plot(atr,"Ordinary ATR5")
plot(pt,"Parent time")
plot(pi,"Standard context index")

[nTick,nScale,nFirstTime,nFirstOpen,nFirstClose]=request.security(native,"360",[syminfo.mintick,syminfo.pricescale,ta.valuewhen(bar_index==0,time,0),ta.valuewhen(bar_index==0,open,0),ta.valuewhen(bar_index==0,close,0)],lookahead=barmerge.lookahead_off,calc_bars_count=depth)
[bFirstTime,bFirstAtr]=request.security(base,"360",[ta.valuewhen(bar_index==0,time,0),ta.valuewhen(not na(ta.atr(5)) and na(ta.atr(5)[1]),ta.atr(5),0)],lookahead=barmerge.lookahead_off,calc_bars_count=depth)
plot(nTick,"Native minimum tick")
plot(nScale,"Native price scale")
plot(nFirstTime,"First requested native time")
plot(nFirstOpen,"First requested native open")
plot(nFirstClose,"First requested native close")
plot(bFirstTime,"First requested standard time")
plot(bFirstAtr,"First valid requested standard ATR5")

[seedo0,seedh0,seedl0,seedc0,seedt0,seedo1,seedh1,seedl1,seedc1,seedt1,seedo2,seedh2,seedl2,seedc2,seedt2,seedo3,seedh3,seedl3,seedc3,seedt3,seedo4,seedh4,seedl4,seedc4,seedt4,seedo5,seedh5,seedl5,seedc5,seedt5]=request.security(base,"360",[ta.valuewhen(bar_index==0,open,0),ta.valuewhen(bar_index==0,high,0),ta.valuewhen(bar_index==0,low,0),ta.valuewhen(bar_index==0,close,0),ta.valuewhen(bar_index==0,time,0),ta.valuewhen(bar_index==1,open,0),ta.valuewhen(bar_index==1,high,0),ta.valuewhen(bar_index==1,low,0),ta.valuewhen(bar_index==1,close,0),ta.valuewhen(bar_index==1,time,0),ta.valuewhen(bar_index==2,open,0),ta.valuewhen(bar_index==2,high,0),ta.valuewhen(bar_index==2,low,0),ta.valuewhen(bar_index==2,close,0),ta.valuewhen(bar_index==2,time,0),ta.valuewhen(bar_index==3,open,0),ta.valuewhen(bar_index==3,high,0),ta.valuewhen(bar_index==3,low,0),ta.valuewhen(bar_index==3,close,0),ta.valuewhen(bar_index==3,time,0),ta.valuewhen(bar_index==4,open,0),ta.valuewhen(bar_index==4,high,0),ta.valuewhen(bar_index==4,low,0),ta.valuewhen(bar_index==4,close,0),ta.valuewhen(bar_index==4,time,0),ta.valuewhen(bar_index==5,open,0),ta.valuewhen(bar_index==5,high,0),ta.valuewhen(bar_index==5,low,0),ta.valuewhen(bar_index==5,close,0),ta.valuewhen(bar_index==5,time,0)],lookahead=barmerge.lookahead_off,calc_bars_count=depth)
plot(seedo0,"Seed o 0")
plot(seedh0,"Seed h 0")
plot(seedl0,"Seed l 0")
plot(seedc0,"Seed c 0")
plot(seedt0,"Seed t 0")
plot(seedo1,"Seed o 1")
plot(seedh1,"Seed h 1")
plot(seedl1,"Seed l 1")
plot(seedc1,"Seed c 1")
plot(seedt1,"Seed t 1")
plot(seedo2,"Seed o 2")
plot(seedh2,"Seed h 2")
plot(seedl2,"Seed l 2")
plot(seedc2,"Seed c 2")
plot(seedt2,"Seed t 2")
plot(seedo3,"Seed o 3")
plot(seedh3,"Seed h 3")
plot(seedl3,"Seed l 3")
plot(seedc3,"Seed c 3")
plot(seedt3,"Seed t 3")
plot(seedo4,"Seed o 4")
plot(seedh4,"Seed h 4")
plot(seedl4,"Seed l 4")
plot(seedc4,"Seed c 4")
plot(seedt4,"Seed t 4")
plot(seedo5,"Seed o 5")
plot(seedh5,"Seed h 5")
plot(seedl5,"Seed l 5")
plot(seedc5,"Seed c 5")
plot(seedt5,"Seed t 5")
firstStrict=request.security(base,"360",ta.valuewhen(not na(ta.rma(ta.tr(false),5)) and na(ta.rma(ta.tr(false),5)[1]),ta.rma(ta.tr(false),5),0),lookahead=barmerge.lookahead_off,calc_bars_count=depth)
plot(firstStrict,"First strict previous-close ATR5")

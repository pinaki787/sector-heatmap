//@version=6
indicator("Sector Pulse Native ATR Length Diagnostic", overlay=false)
base = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
[o1,c1,t1] = request.security(ticker.renko(base, "ATR", 1, false, "Close"), "360", [open,close,time], lookahead=barmerge.lookahead_off)
[a1,pa1] = request.security(base, "360", [ta.atr(1),ta.atr(1)[1]], lookahead=barmerge.lookahead_off)
plot(math.abs(c1-o1), "Native box length 1")
plot(a1, "Ordinary ATR length 1")
plot(pa1, "Prior ordinary ATR length 1")
plot(t1, "Native timestamp length 1")
[o2,c2,t2] = request.security(ticker.renko(base, "ATR", 2, false, "Close"), "360", [open,close,time], lookahead=barmerge.lookahead_off)

//@version=6
indicator("Sector Pulse ETH Origin OHLC Control", overlay=false)
base=ticker.new(syminfo.prefix,syminfo.ticker,session.regular)
f_bar(n) =>
    var float bt=na
    var float bo=na
    var float bh=na
    var float bl=na
    var float bc=na
    if bar_index == n
        bt:=time
        bo:=open
        bh:=high
        bl:=low
        bc:=close
    [bt,bo,bh,bl,bc]
[t0,o0,h0,l0,c0]=request.security(base,"1380",f_bar(0),lookahead=barmerge.lookahead_off,calc_bars_count=20000)
plot(t0,"Origin 0 t")
plot(o0,"Origin 0 o")
plot(h0,"Origin 0 h")
plot(l0,"Origin 0 l")
plot(c0,"Origin 0 c")
[t1,o1,h1,l1,c1]=request.security(base,"1380",f_bar(1),lookahead=barmerge.lookahead_off,calc_bars_count=20000)
plot(t1,"Origin 1 t")

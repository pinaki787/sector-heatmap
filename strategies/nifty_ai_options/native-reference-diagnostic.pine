//@version=6
indicator("Sector Pulse Native Sizing Diagnostic", overlay=false)
base = ticker.new(syminfo.prefix, syminfo.ticker, session.regular)
native = ticker.renko(base, "ATR", 5, false, "Close")
[no, nc, nativeAtr, nativeTr, nativeTime, priorNativeAtr] = request.security(native, "360", [open, close, ta.atr(5), ta.tr(true), time, ta.atr(5)[1]], lookahead=barmerge.lookahead_off)
[ordinaryAtr, parentClose, priorOrdinaryAtr] = request.security(base, "360", [ta.atr(5), time_close, ta.atr(5)[1]], lookahead=barmerge.lookahead_off)
plot(math.abs(nc-no), "Native Renko box")
plot(nativeAtr, "ATR5 calculated on native Renko bars")
plot(priorNativeAtr, "Prior native-bar ATR5")
plot(nativeTr, "Native true range")
plot(nativeTime, "Native bar timestamp")
plot(ordinaryAtr, "Ordinary parent ATR5")
plot(priorOrdinaryAtr, "Prior ordinary parent ATR5")
plot(parentClose, "Standard parent close timestamp")
plot(syminfo.mintick, "Minimum tick")

[po, ph, pl, pc, pt] = request.security(base, "360", [open, high, low, close, time], lookahead=barmerge.lookahead_off)
plot(po, "Parent open")
plot(ph, "Parent high")
plot(pl, "Parent low")
plot(pc, "Parent close")
plot(pt, "Parent open timestamp")

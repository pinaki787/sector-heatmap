//@version=6
indicator("Pinaki Renko ST Auto Research", shorttitle="PRST Auto Research", overlay=true)
// Independent candidate; initialization and applied parity are tested separately.
autoLength = input.int(5, "ATR Length", minval=1, group="AI RENKO SUPERTREND SETTINGS", tooltip="ATR period used for Auto brick sizing and synthetic Supertrend smoothing. Calculations use the current chart bars.")
stLength = autoLength
factor = input.float(3.0, "Base Factor", minval=0.1, step=0.1, group="AI RENKO SUPERTREND SETTINGS")
brickMode = input.string("Auto", "Brick size mode", options=["Auto", "Manual"], group="AI RENKO SUPERTREND SETTINGS", tooltip="Auto uses the verified volatility-based ATR calculation. Manual uses your specified size in price points.")
manualBrick = input.float(12.8, "Manual Brick Size", minval=0.00000001, active=brickMode == "Manual", display=display.none, group="AI RENKO SUPERTREND SETTINGS", tooltip="A positive size in price points. Used only when Brick size mode is Manual.")
useAdx = input.bool(false, "Choppy Filter (ADX)", group="AI RENKO SUPERTREND SETTINGS", tooltip="Gate confirmed BUY/SELL reversals using chart-bar ADX. The protected reference does not expose its ADX periods; this reconstruction uses the configurable periods below.")
adxThreshold = input.float(20.0, "ADX Threshold", minval=0.0, maxval=100.0, active=useAdx, group="AI RENKO SUPERTREND SETTINGS")
color bullColor = input.color(color.rgb(46, 160, 67), "Bull Color", group="AI RENKO SUPERTREND SETTINGS")
color bearColor = input.color(color.rgb(229, 57, 53), "Bear Color", group="AI RENKO SUPERTREND SETTINGS")
adxLength = input.int(14, "ADX DI Length", minval=1, active=useAdx, group="ADX RECONSTRUCTION", display=display.none)
adxSmoothing = input.int(14, "ADX Smoothing", minval=1, active=useAdx, group="ADX RECONSTRUCTION", display=display.none)
[plusDi, minusDi, adxValue] = ta.dmi(adxLength, adxSmoothing)
bool signalAllowed = not useAdx or (not na(adxValue) and adxValue > adxThreshold)
if not chart.is_standard and not chart.is_renko
    runtime.error("Use standard time candles or a native Renko chart.")
float hostTr = ta.tr(true)
var float hostAtr = na
hostAtr := ta.atr(autoLength)
float regimeAtr = ta.atr(15)
float lowAtr = ta.atr(9)
float volatilityRatio = regimeAtr > 0 ? hostAtr / regimeAtr : 1.0
float effectiveFactor = factor + (volatilityRatio > 1.2 ? 1.0 : volatilityRatio < 0.8 ? -0.5 : 0.0)
float autoBox = math.max(syminfo.mintick, volatilityRatio > 1.2 ? hostAtr * 1.5 : volatilityRatio < 0.8 ? lowAtr * 0.7 : hostAtr)
float box = brickMode == "Manual" ? manualBrick : autoBox
var float rc = na
var float ro = na
var float syntheticAtr = na
var float upper = na
var float lower = na
var float st = na
var int direction = 1
if na(rc)
    rc := close
    ro := close
float previousRc = rc
float delta = close - rc
int steps = box > 0 ? int(math.floor(math.abs(delta) / box)) : 0
if steps >= 1
    ro := rc
    rc += math.sign(delta) * steps * box
float rh = math.max(ro, rc)
float rl = math.min(ro, rc)
float syntheticTr = math.max(rh - rl, math.max(math.abs(rh - previousRc), math.abs(rl - previousRc)))
syntheticAtr := na(syntheticAtr) ? syntheticTr : syntheticAtr + (syntheticTr - syntheticAtr) / stLength
float midpoint = (rh + rl) / 2
float basicUpper = midpoint + effectiveFactor * syntheticAtr
float basicLower = midpoint - effectiveFactor * syntheticAtr
float previousUpper = upper
float previousLower = lower
float previousSt = st
upper := na(previousUpper) or basicUpper < previousUpper or previousRc > previousUpper ? basicUpper : previousUpper
lower := na(previousLower) or basicLower > previousLower or previousRc < previousLower ? basicLower : previousLower
if na(previousSt)
    direction := 1
else if previousSt == previousUpper
    direction := rc > upper ? -1 : 1
else
    direction := rc < lower ? 1 : -1
st := direction < 0 ? lower : upper
bullPlot = plot(direction < 0 ? st : na, "Research bullish line", color=bullColor, display=display.data_window)
bearPlot = plot(direction > 0 ? st : na, "Research bearish line", color=bearColor, display=display.data_window)
plot(st, "Connected Supertrend", color=direction < 0 ? bullColor : bearColor, linewidth=2, style=plot.style_line)
pricePlot = plot(close, "Gradient price anchor", color=na, display=display.none)
fill(pricePlot, bullPlot, math.max(close, st), math.min(close, st), color.new(bullColor, 96), color.new(bullColor, 78), title="Bullish green gradient", fillgaps=false)
fill(pricePlot, bearPlot, math.max(close, st), math.min(close, st), color.new(bearColor, 78), color.new(bearColor, 96), title="Bearish red gradient", fillgaps=false)
plot(box, "Active brick size", display=display.status_line + display.data_window, precision=2)
plot(rc, "Synthetic close", display=display.data_window)
plot(ro, "Synthetic open", display=display.data_window)
plot(syntheticAtr, "Host-updated synthetic ATR", display=display.data_window)
plot(direction, "Direction (-1 bullish)", display=display.data_window)
buySignal = signalAllowed and barstate.isconfirmed and direction < 0 and direction[1] > 0
sellSignal = signalAllowed and barstate.isconfirmed and direction > 0 and direction[1] < 0
plotshape(buySignal ? low : na, title="PRST BUY", style=shape.labelup, location=location.absolute, color=bullColor, text="BUY", textcolor=color.white, size=size.tiny)
plotshape(sellSignal ? high : na, title="PRST SELL", style=shape.labeldown, location=location.absolute, color=bearColor, text="SELL", textcolor=color.white, size=size.tiny)
plot(buySignal ? 1 : 0, "Confirmed BUY flag", display=display.data_window)
plot(sellSignal ? 1 : 0, "Confirmed SELL flag", display=display.data_window)
plot(hostAtr, "Unscaled host ATR", display=display.data_window)
plot(volatilityRatio, "Volatility regime ratio", display=display.data_window)
plot(effectiveFactor, "Effective factor hypothesis", display=display.data_window)
plot(autoBox, "Auto calculated brick size", display=display.data_window, precision=2)
plot(adxValue, "Chart-bar ADX", display=display.data_window)
plot(signalAllowed ? 1 : 0, "ADX signal allowed", display=display.data_window)
// The panel shows indicator sizing independently of the native chart brick settings.
var table brickInfo = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 12), border_width=1)
if barstate.islast
    table.cell(brickInfo, 0, 0, "PRST brick mode", text_color=color.white)
    table.cell(brickInfo, 1, 0, brickMode, text_color=color.aqua)
    table.cell(brickInfo, 0, 1, brickMode == "Auto" ? "Indicator Auto brick" : "Indicator Manual brick", text_color=color.white)
    table.cell(brickInfo, 1, 1, na(box) ? "Warming up" : str.tostring(box, "0.00"), text_color=color.aqua)
    table.cell(brickInfo, 0, 2, "Calculated on", text_color=color.white)
    table.cell(brickInfo, 1, 2, chart.is_renko ? "Native Renko bars" : "Time candles", text_color=color.white)

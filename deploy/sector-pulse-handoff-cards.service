[Unit]
Description=Sector Pulse Analysis Handoff images
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trading
Group=trading
WorkingDirectory=/home/trading/sector-heatmap
ExecStart=/home/trading/sector-heatmap/.venv/bin/python -B -m sector_heatmap.handoff_cards run
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trading/sector-heatmap/.private/notifications /home/trading/sector-heatmap/.private/dashboard-login/accounts/a6ef4c9bcecd21d54c4a07e2b9b137a7/source/.private /home/trading/sector-heatmap/.private/dashboard-login/accounts/b0041912d9d6f68d352814cbd24bf6da/source/.private /home/trading/sector-heatmap/.private/dashboard-login/accounts/bf46fc364b610a0dfd338419e133cb41/source/.private

[Install]
WantedBy=multi-user.target


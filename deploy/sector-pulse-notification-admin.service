[Unit]
Description=Sector Pulse User Master notification settings
After=network.target

[Service]
Type=simple
User=trading
Group=trading
WorkingDirectory=/home/trading/sector-heatmap
ExecStart=/home/trading/sector-heatmap/.venv/bin/python -B -m sector_heatmap.notification_admin
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/trading/sector-heatmap/.private/dashboard-login

[Install]
WantedBy=multi-user.target


//@version=6
indicator("Sector Pulse V1", overlay=true, behind_chart=false, precision=2, max_lines_count=500, max_labels_count=500, max_boxes_count=500, max_bars_back=5000)
max_bars_back(time,5000)
// Independent reconstruction. See research/sector_pulse_merge_20261109/REPORT.md.
// Reference historical timing uses lookahead_off after recalculation.
// This is a visual parity candidate, not a validated causal trading signal.
string gRef="01 — REFERENCE & SESSION"
string refMode=input.string("Auto","Reference timeframe selection",options=["Auto","Manual"],group=gRef,display=display.none)
string manualRef=input.timeframe("5","Manual reference timeframe",group=gRef,display=display.none)
string optionMode=input.string("Auto","Indian option reference candle",options=["Auto","Force PE Green","Force Red"],group=gRef,display=display.none)
string sessionMode=input.string("Auto","Session preset",options=["Auto","Manual"],group=gRef,display=display.none)
string sess=input.session("0915-1530","Manual session",group=gRef,display=display.none)
string tz=input.string("Asia/Kolkata","Manual timezone (IANA)",group=gRef,display=display.none)
string openingMode=input.string("Auto gap + IST fallback","Global opening detection",options=["Auto gap + IST fallback","Fixed IST opening"],group="01A — GLOBAL BROKER SESSION (30M)",display=display.none)
int fxHour=input.int(3,"Gold/FX fallback opening hour (IST)",minval=0,maxval=23,group="01A — GLOBAL BROKER SESSION (30M)",display=display.none)
int fxMinute=input.int(30,"Gold/FX fallback opening minute (IST)",options=[0,15,30,45],group="01A — GLOBAL BROKER SESSION (30M)",display=display.none)
int cryptoHour=input.int(2,"Crypto daily reset hour (IST)",minval=0,maxval=23,group="01A — GLOBAL BROKER SESSION (30M)",display=display.none)
int cryptoMinute=input.int(30,"Crypto daily reset minute (IST)",options=[0,15,30,45],group="01A — GLOBAL BROKER SESSION (30M)",display=display.none)
int openingGap=input.int(45,"Minimum trading break for opening detection (minutes)",minval=1,group="01A — GLOBAL BROKER SESSION (30M)",display=display.none)
bool show30=input.bool(false,"Show EXTRA 30m Red Bar zone (India only)",group="01B — EXTRA INDIA 30M SELLING ZONE",display=display.none)
color extraColor=input.color(color.rgb(220,38,38),"30m zone colour (Red)",group="01B — EXTRA INDIA 30M SELLING ZONE",display=display.none)
int extraTransparency=input.int(91,"30m zone transparency",minval=0,maxval=100,group="01B — EXTRA INDIA 30M SELLING ZONE",display=display.none)
bool extraLevels=input.bool(true,"Show 30m 44 / 50 / 56% levels",group="01B — EXTRA INDIA 30M SELLING ZONE",display=display.none)
bool highlight=input.bool(true,"Highlight actual locked Red Bar candle",group="02 — CHART VISIBILITY",display=display.none)
bool show5=input.bool(true,"Show 44%, 50%, 56% INSIDE Red Bar",group="02 — CHART VISIBILITY",display=display.none)
bool targetBands=input.bool(true,"Show 44%-56% BANDS centered on EACH target",group="02 — CHART VISIBILITY",display=display.none)
string targetMode=input.string("SMART","Target Display Mode",options=["SMART","ALL","OFF"],group="02 — CHART VISIBILITY",display=display.none)
int forward=input.int(2,"SMART Forward Targets",options=[1,2,3],group="02 — CHART VISIBILITY",display=display.none)
int targetTransparency=input.int(90,"Target band fill transparency",minval=0,maxval=100,group="02 — CHART VISIBILITY",display=display.none)
int mainWidth=input.int(4,"Main High / Low line thickness",minval=1,maxval=4,group="02 — CHART VISIBILITY",display=display.none)
int targetWidth=input.int(3,"Target line thickness",minval=1,maxval=4,group="02 — CHART VISIBILITY",display=display.none)
int bandWidth=input.int(2,"Target 44/50/56 line thickness",minval=1,maxval=4,group="02 — CHART VISIBILITY",display=display.none)
bool showTargets=input.bool(true,"Show bullish / bearish targets",group="02 — CHART VISIBILITY",display=display.none)
color pendingColor=input.color(color.rgb(245,151,34),"Pending target (Orange)",group="02 — CHART VISIBILITY",display=display.none)
color upperColor=input.color(color.rgb(42,200,102),"Upper target reached (Green)",group="02 — CHART VISIBILITY",display=display.none)
color lowerColor=input.color(color.rgb(255,0,0),"Lower target reached (Bright Red)",group="02 — CHART VISIBILITY",display=display.none)
int targetCount=input.int(10,"Maximum targets",options=[5,10,15,20],group="02 — CHART VISIBILITY",display=display.none)
bool autoScale=input.bool(false,"Auto-scale chart to T15/T20 (compresses candles)",group="02 — CHART VISIBILITY",display=display.none)
bool targetLabels=input.bool(true,"Show T11-T20 price labels",group="02 — CHART VISIBILITY",display=display.none)
bool bothDirections=input.bool(true,"Show both target directions",group="02 — CHART VISIBILITY",display=display.none)
int historyInput=input.int(8,"Historical sessions to retain (object limit)",minval=1,maxval=8,group="02 — CHART VISIBILITY",display=display.none)
bool crypto=syminfo.type=="crypto" or syminfo.prefix=="DELTAIN" or syminfo.prefix=="BINANCE" or syminfo.prefix=="BYBIT"
// MCX commodities use the broker-aware 30m reference, not the NSE/BSE equity session.
bool india=syminfo.prefix=="NSE" or syminfo.prefix=="BSE"
bool indianOption=india and (not na(str.match(syminfo.ticker,".*[0-9]PE$")) or (syminfo.type=="option" and not na(str.match(syminfo.ticker,".*P[0-9]+$"))))
bool greenReference=optionMode=="Force PE Green" or (optionMode=="Auto" and indianOption)
string refTF=refMode=="Manual" ? manualRef : india ? "5" : "30"
string symbol=ticker.standard(syminfo.tickerid)
f_ref() =>
    bool manual=sessionMode=="Manual"
    bool inSess=manual or india ? not na(time(timeframe.period,sess,tz)) : true
    int resetMinutes=crypto ? cryptoHour*60+cryptoMinute : fxHour*60+fxMinute
    int key=manual or india ? time("D") : int(math.floor((time+19800000-resetMinutes*60000)/86400000))
    bool gap=openingMode=="Auto gap + IST fallback" and not crypto and not india and time-time_close[1]>=openingGap*60000
    bool first=inSess and (not inSess[1] or key!=key[1] or gap)
    var float hi=na
    var float lo=na
    var int sessionStart=na
    var int lockedTime=na
    if first
        hi:=na
        lo:=na
        lockedTime:=na
        sessionStart:=time
    bool wanted=greenReference ? close>open : close<open
    if inSess and not first and na(hi) and wanted
        hi:=high
        lo:=low
        lockedTime:=time
    [hi,lo,sessionStart,lockedTime]
[a,b,k5,lock5]=request.security(symbol,refTF,f_ref(),lookahead=barmerge.lookahead_off)
[c,d,k30,lock30]=request.security(symbol,"30",f_ref(),lookahead=barmerge.lookahead_off)
bool active=not na(a) and not na(b)
int start=k5
float h5=a
float l5=b
float h30=c
float l30=d
f_level(float h,float l,float p) => l+(h-l)*p
pHigh=plot(h5,"LOCKED RED BAR HIGH",color.rgb(184,90,0),mainWidth,plot.style_linebr)
pLow=plot(l5,"LOCKED RED BAR LOW",color.rgb(213,0,0),mainWidth,plot.style_linebr)
plot(show5 ? f_level(h5,l5,0.44) : na,"44%",color.rgb(227,125,50),bandWidth,plot.style_linebr)
plot(show5 ? f_level(h5,l5,0.50) : na,"50%",color.orange,bandWidth,plot.style_linebr)
plot(show5 ? f_level(h5,l5,0.56) : na,"56%",color.rgb(227,125,50),bandWidth,plot.style_linebr)
plot(autoScale and barstate.islast ? h5+(h5-l5)*targetCount : na,"Extended upper scale anchor",color.new(color.white,100))
plot(autoScale and barstate.islast ? l5-(h5-l5)*targetCount : na,"Extended lower scale anchor",color.new(color.white,100))
fill(pHigh,pLow,color.new(color.red,94))

// Extra Indian 30m zones are drawing objects, not additional legend plots.
type ExtraZone
    float hi
    float lo
    int left
    int right
var array<ExtraZone> extraZones=array.new<ExtraZone>()
var array<box> extraBoxes=array.new<box>()
var array<line> extraLines=array.new<line>()
if india and not na(lock30) and (na(lock30[1]) or lock30!=lock30[1])
    array.push(extraZones,ExtraZone.new(h30,l30,lock30,time))
    if array.size(extraZones)>historyInput
        array.shift(extraZones)
if india and array.size(extraZones)>0
    ExtraZone latestExtra=array.last(extraZones)
    latestExtra.right:=time
if barstate.islast
    for item in extraBoxes
        box.delete(item)
    array.clear(extraBoxes)
    for item in extraLines
        line.delete(item)
    array.clear(extraLines)
    if show30 and india
        for rec in extraZones
            array.push(extraBoxes,box.new(rec.left,rec.hi,rec.right,rec.lo,xloc=xloc.bar_time,border_color=color.new(extraColor,100),bgcolor=color.new(extraColor,extraTransparency)))
            if extraLevels
                for p in array.from(.44,.50,.56)
                    float price=rec.lo+(rec.hi-rec.lo)*p
                    array.push(extraLines,line.new(rec.left,price,rec.right,price,xloc=xloc.bar_time,color=extraColor,width=bandWidth))
var array<box> referenceBoxes=array.new<box>()
bool freshLock=not na(lock5) and (na(lock5[1]) or lock5!=lock5[1])
if highlight and freshLock
    array.push(referenceBoxes,box.new(lock5,h5,lock5+int(timeframe.in_seconds(refTF))*1000,l5,xloc=xloc.bar_time,border_color=color.new(color.red,35),bgcolor=color.new(color.red,90)))
    if array.size(referenceBoxes)>historyInput
        box.delete(array.shift(referenceBoxes))
bool showSMA=input.bool(true,"Show 200 SMA High/Low Band",group="OB · 01 — 200 SMA HIGH / LOW (2M SOURCE; UP TO 30M)",display=display.none)
int maLength=input.int(200,"200 SMA Length (2m Bars)",minval=1,group="OB · 01 — 200 SMA HIGH / LOW (2M SOURCE; UP TO 30M)",display=display.none)
color maBull=input.color(color.rgb(0,180,90),"Above Band — Green",group="OB · 01 — 200 SMA HIGH / LOW (2M SOURCE; UP TO 30M)",display=display.none)
color maBear=input.color(color.rgb(220,50,55),"Below Band — Red",group="OB · 01 — 200 SMA HIGH / LOW (2M SOURCE; UP TO 30M)",display=display.none)
color maNeutral=input.color(color.rgb(150,150,150),"Inside Band — Neutral",group="OB · 01 — 200 SMA HIGH / LOW (2M SOURCE; UP TO 30M)",display=display.none)
bool maFill=input.bool(true,"Fill 200 SMA Band",group="OB · 01 — 200 SMA HIGH / LOW (2M SOURCE; UP TO 30M)",display=display.none)
bool showSlow=input.bool(true,"Show 5 SMA Close",group="OB · 02 — 5 SMA CLOSE TREND (30M AND ABOVE)",display=display.none)
int slowLength=input.int(5,"SMA Close Length",minval=1,group="OB · 02 — 5 SMA CLOSE TREND (30M AND ABOVE)",display=display.none)
color slowBull=input.color(color.rgb(0,230,118),"Close Above SMA — Green",group="OB · 02 — 5 SMA CLOSE TREND (30M AND ABOVE)",display=display.none)
color slowBear=input.color(color.rgb(242,54,69),"Close Below SMA — Red",group="OB · 02 — 5 SMA CLOSE TREND (30M AND ABOVE)",display=display.none)
int maWidth=input.int(2,"SMA Line Width",minval=1,maxval=4,group="03 — VISUAL SETTINGS",display=display.none)
int maTransparency=input.int(88,"200 SMA Band Fill Transparency",minval=0,maxval=100,group="03 — VISUAL SETTINGS",display=display.none)
[sh,sl]=request.security(symbol,"2",[ta.sma(high,maLength),ta.sma(low,maLength)],lookahead=barmerge.lookahead_off)
color sc=close>sh ? maBull : close<sl ? maBear : maNeutral
psh=plot(showSMA and timeframe.in_seconds()<=1800 ? sh : na,"200 SMA High — 2m",sc,maWidth)
psl=plot(showSMA and timeframe.in_seconds()<=1800 ? sl : na,"200 SMA Low — 2m",sc,maWidth)
fill(psh,psl,maFill ? color.new(sc,maTransparency) : na)
float sma5=ta.sma(close,slowLength)
plot(showSlow and timeframe.in_seconds()>=1800 ? sma5 : na,"5 SMA Close — 30m+",close>sma5 ? slowBull : slowBear,maWidth)

// Target reveal and first-touch times are retained. Cross-market parity remains under review.
type TargetSession
    float hi
    float lo
    int key
    int finish
    array<int> revealUp
    array<int> revealDown
    array<int> hitUp
    array<int> hitDown
var array<TargetSession> targetSessions=array.new<TargetSession>()
var array<line> targetLines=array.new<line>()
var array<box> targetBoxes=array.new<box>()
var array<label> targetText=array.new<label>()
bool newSession=active and (array.size(targetSessions)==0 or array.last(targetSessions).key!=k5)
if newSession
    array.push(targetSessions,TargetSession.new(a,b,k5,time,array.new<int>(20,na),array.new<int>(20,na),array.new<int>(20,na),array.new<int>(20,na)))
    if array.size(targetSessions)>historyInput
        array.shift(targetSessions)
if active and array.size(targetSessions)>0
    TargetSession rec=array.last(targetSessions)
    rec.finish:=time
    float span=rec.hi-rec.lo
    if span>0
        for n=1 to 20
            float up=rec.hi+n*span
            float down=rec.lo-n*span
            if na(array.get(rec.hitUp,n-1)) and high>=up
                array.set(rec.hitUp,n-1,time)
            if na(array.get(rec.hitDown,n-1)) and low<=down
                array.set(rec.hitDown,n-1,time)
            int upAhead=math.max(1,int(math.floor((close-rec.hi)/span))+forward)
            int dnAhead=math.max(1,int(math.floor((rec.lo-close)/span))+forward)
            if (newSession or barstate.isconfirmed) and n<=upAhead and na(array.get(rec.revealUp,n-1))
                array.set(rec.revealUp,n-1,time)
            if (newSession or barstate.isconfirmed) and n<=dnAhead and na(array.get(rec.revealDown,n-1))
                array.set(rec.revealDown,n-1,time)
f_targetSegment(int left,int right,float price,float span,color col) =>
    if right>=left
        array.push(targetLines,line.new(left,price,right,price,xloc=xloc.bar_time,color=col,width=targetWidth))
        while array.size(targetLines) > 90
            line.delete(array.shift(targetLines))
        if targetBands
            array.push(targetBoxes,box.new(left,price+span*.06,right,price-span*.06,xloc=xloc.bar_time,border_color=color.new(col,90),border_width=bandWidth,bgcolor=color.new(col,targetTransparency)))
            while array.size(targetBoxes) > 180
                box.delete(array.shift(targetBoxes))
f_renderTarget(TargetSession rec,int n,bool upper) =>
    float span=rec.hi-rec.lo
    float price=upper ? rec.hi+n*span : rec.lo-n*span
    int reveal=targetMode=="ALL" ? rec.key : upper ? array.get(rec.revealUp,n-1) : array.get(rec.revealDown,n-1)
    int hit=upper ? array.get(rec.hitUp,n-1) : array.get(rec.hitDown,n-1)
    color reached=upper ? upperColor : lowerColor
    if not na(reveal)
        if na(hit) or hit>rec.finish
            f_targetSegment(reveal,rec.finish,price,span,pendingColor)
        else
            if hit>reveal
                f_targetSegment(reveal,hit,price,span,pendingColor)
            f_targetSegment(math.max(reveal,hit),rec.finish,price,span,reached)
        if targetLabels and n>10
            array.push(targetText,label.new(rec.finish,price,"T"+str.tostring(n)+" "+str.tostring(price,"#.##"),xloc=xloc.bar_time,style=label.style_label_left,color=color.new(color.black,100),textcolor=na(hit) ? pendingColor : reached,size=size.tiny))
if barstate.islast
    for item in targetLines
        line.delete(item)
    array.clear(targetLines)
    for item in targetBoxes
        box.delete(item)
    array.clear(targetBoxes)
    for item in targetText
        label.delete(item)
    array.clear(targetText)
    if showTargets and targetMode!="OFF" and array.size(targetSessions)>0
        for rec in targetSessions
            for n=1 to targetCount
                f_renderTarget(rec,n,true)
                if bothDirections
                    f_renderTarget(rec,n,false)

// Shared TradingView object budget: keep newest targetLines.
if barstate.islast
    while array.size(targetLines) > 90
        line.delete(array.shift(targetLines))

// Shared TradingView object budget: keep newest targetBoxes.
if barstate.islast
    while array.size(targetBoxes) > 180
        box.delete(array.shift(targetBoxes))

// Independent 30-minute candle windows use standard market candles.
string gWindow="05 — INDEPENDENT IST CANDLE WINDOWS"
bool mark1230=input.bool(true,"Mark 12:30-13:00 IST",group=gWindow,display=display.none)
bool mark1730=input.bool(true,"Mark 17:30-18:00 IST",group=gWindow,display=display.none)
color color1230=input.color(color.rgb(0,175,230),"12:30 color",group=gWindow,display=display.none)
color color1730=input.color(color.rgb(165,65,240),"17:30 color",group=gWindow,display=display.none)
int windowTransparency=input.int(78,"Candle box transparency",minval=0,maxval=100,group=gWindow,display=display.none)
bool windowInternal=input.bool(true,"Show 44/50/56% inside candle",group=gWindow,display=display.none)
bool windowExtend=input.bool(true,"Extend 44/50/56% candleSpan levels",group=gWindow,display=display.none)
bool windowHL=input.bool(false,"Also extend High/Low",group=gWindow,display=display.none)
int windowKeep=input.int(8,"Keep last N windows",minval=1,maxval=20,group=gWindow,display=display.none)
string gCut="05A — MARKER NEXT RED BAR CUTOFF"
string markerTF=input.timeframe("30","Red Bar timeframe",group=gCut,display=display.none)
int markerHour=input.int(2,"Session start IST hour (BTC 02:30)",minval=0,maxval=23,group=gCut,display=display.none)
int markerMinute=input.int(30,"Session start IST minute",options=[0,15,30,45],group=gCut,display=display.none)
bool markerSkip=input.bool(true,"Ignore first session candle",group=gCut,display=display.none)
f_window(int hh,int mm) =>
    bool selected=hour(time,"Asia/Kolkata")==hh and minute(time,"Asia/Kolkata")==mm
    var float wh=na
    var float wl=na
    var int wt=na
    var int we=na
    if selected
        wh:=high
        wl:=low
        wt:=time
        we:=time_close
    [wh,wl,wt,we]
f_markerCutoff() =>
    int key=int(math.floor((time+19800000-(markerHour*60+markerMinute)*60000)/86400000))
    bool first=key!=key[1]
    var int locked=na
    var int lastKey=na
    if first
        lastKey:=na
    if close<open and (not markerSkip or not first) and na(lastKey)
        locked:=time_close
        lastKey:=key
    locked
[w1h,w1l,w1t,w1e]=request.security(symbol,"30",f_window(12,30),lookahead=barmerge.lookahead_off)
[w2h,w2l,w2t,w2e]=request.security(symbol,"30",f_window(17,30),lookahead=barmerge.lookahead_off)
int markerCut=request.security(symbol,markerTF,f_markerCutoff(),lookahead=barmerge.lookahead_off)
type WindowRecord
    float hi
    float lo
    int start
    int finish
    int cutoff
    int kind
var array<WindowRecord> windows=array.new<WindowRecord>()
var array<box> windowBoxes=array.new<box>()
var array<line> windowLines=array.new<line>()
if not na(w1t) and (na(w1t[1]) or w1t!=w1t[1])
    array.push(windows,WindowRecord.new(w1h,w1l,w1t,w1e,na,1))
if not na(w2t) and (na(w2t[1]) or w2t!=w2t[1])
    array.push(windows,WindowRecord.new(w2h,w2l,w2t,w2e,na,2))
if array.size(windows)>windowKeep
    array.shift(windows)
for rec in windows
    if na(rec.cutoff) and not na(markerCut) and markerCut>rec.finish
        rec.cutoff:=markerCut
if barstate.islast
    for item in windowBoxes
        box.delete(item)
    array.clear(windowBoxes)
    for item in windowLines
        line.delete(item)
    array.clear(windowLines)
    for rec in windows
        bool enabled=rec.kind==1 ? mark1230 : mark1730
        if enabled
            color col=rec.kind==1 ? color1230 : color1730
            array.push(windowBoxes,box.new(rec.start,rec.hi,rec.finish,rec.lo,xloc=xloc.bar_time,border_color=col,border_width=2,bgcolor=color.new(col,windowTransparency)))
            for p in array.from(.44,.50,.56)
                float price=rec.lo+(rec.hi-rec.lo)*p
                if windowInternal
                    array.push(windowLines,line.new(rec.start,price,rec.finish,price,xloc=xloc.bar_time,color=col,width=p==.50 ? 2 : 1))
                    while array.size(windowLines) > 60
                        line.delete(array.shift(windowLines))
                if windowExtend
                    int right=na(rec.cutoff) ? time : rec.cutoff
                    array.push(windowLines,line.new(rec.finish,price,right,price,xloc=xloc.bar_time,color=col,width=p==.50 ? 2 : 1,style=line.style_dotted))
                    while array.size(windowLines) > 60
                        line.delete(array.shift(windowLines))
            if windowHL
                int right=na(rec.cutoff) ? time : rec.cutoff
                array.push(windowLines,line.new(rec.finish,rec.hi,right,rec.hi,xloc=xloc.bar_time,color=col,style=line.style_dotted))
                while array.size(windowLines) > 60
                    line.delete(array.shift(windowLines))
                array.push(windowLines,line.new(rec.finish,rec.lo,right,rec.lo,xloc=xloc.bar_time,color=col,style=line.style_dotted))
                while array.size(windowLines) > 60
                    line.delete(array.shift(windowLines))

// Shared TradingView object budget: keep newest windowLines.
if barstate.islast
    while array.size(windowLines) > 60
        line.delete(array.shift(windowLines))

// Observational dashboard inference. These proxies are not the private engine formulas.
bool showDashboard=input.bool(true,"Show dashboard",group="02 — CHART VISIBILITY",display=display.none)
string dashboardMode=input.string("Compact","Dashboard mode",options=["Compact","Detailed","Off"],group="00 | RESEARCH DASHBOARD",display=display.none)
string dashboardPosition=input.string("Top Right","Dashboard position",options=["Top Right","Top Left","Bottom Right","Bottom Left"],group="00 | RESEARCH DASHBOARD",display=display.none)
string gInference="INFERRED ENGINE SETTINGS"
bool inferDashboard=input.bool(true,"Use inferred dashboard states",group=gInference,tooltip="Approximate states calibrated against exported observations. This does not establish exact reference-engine parity.",display=display.none)
int inferredPeriod=input.int(123,"Sector Pulse Gaussian period (inferred)",minval=5,maxval=500,group=gInference,display=display.none)
int inferredATR=input.int(14,"Trend proxy ATR length",minval=1,group=gInference,display=display.none)
float inferredFactor=input.float(5.7,"Trend proxy factor (inferred)",minval=0.1,step=0.1,group=gInference,display=display.none)
float inferredBeta=(1-math.cos(2*math.pi/inferredPeriod))/(math.pow(2.0,1.0/3.0)-1)
float inferredAlpha=-inferredBeta+math.sqrt(inferredBeta*inferredBeta+2*inferredBeta)
var float inferredG1=na
var float inferredG2=na
var float inferredG3=na
inferredG1:=na(inferredG1[1]) ? close : inferredAlpha*close+(1-inferredAlpha)*inferredG1[1]
inferredG2:=na(inferredG2[1]) ? inferredG1 : inferredAlpha*inferredG1+(1-inferredAlpha)*inferredG2[1]
inferredG3:=na(inferredG3[1]) ? inferredG2 : inferredAlpha*inferredG2+(1-inferredAlpha)*inferredG3[1]
[inferredTrendLine,inferredTrendDirection]=ta.supertrend(inferredFactor,inferredATR)
int inferredTrendState=na(inferredTrendDirection) ? 0 : inferredTrendDirection<0 ? 1 : -1
int inferredDirection=na(inferredG3[1]) ? 0 : inferredG3>inferredG3[1] ? 1 : inferredG3<inferredG3[1] ? -1 : 0
int inferredSMA=na(sh) or na(sl) ? 0 : close>sh ? 1 : close<sl ? -1 : 0
int inferredBullVotes=(inferredTrendState==1 ? 1 : 0)+(inferredDirection==1 ? 1 : 0)+(inferredSMA==1 ? 1 : 0)
int inferredBearVotes=(inferredTrendState==-1 ? 1 : 0)+(inferredDirection==-1 ? 1 : 0)+(inferredSMA==-1 ? 1 : 0)
int inferredVoteCount=math.max(inferredBullVotes,inferredBearVotes)
string inferredRegime=inferredBullVotes==3 ? "STRONG BULL" : inferredBearVotes==3 ? "STRONG BEAR" : inferredBullVotes==2 ? "BULLISH" : inferredBearVotes==2 ? "BEARISH" : "MIXED"
bool inferenceReady=chart.is_standard and bar_index>=math.max(200,inferredPeriod*2) and not na(sh) and not na(sl) and not na(inferredTrendLine)
bool inferenceActive=inferDashboard and inferenceReady
string dashboardAnchor=switch dashboardPosition
    "Top Left" => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left" => position.bottom_left
    => position.top_right
color dashboardBg=color.rgb(12,17,28)
color dashboardAlt=color.rgb(23,32,46)
color dashboardBorder=color.rgb(78,69,53)
color dashboardLabel=color.rgb(165,179,197)
color dashboardPending=color.rgb(245,181,80)
color dashboardBull=color.rgb(104,219,166)
color dashboardBear=color.rgb(245,108,117)
f_inferredColor(int direction) =>
    direction>0 ? dashboardBull : direction<0 ? dashboardBear : dashboardLabel
var table researchDashboard=table.new(dashboardAnchor,2,10,bgcolor=dashboardBg,frame_color=color.rgb(187,156,91),frame_width=2,border_color=dashboardBorder,border_width=1)
f_dashboardRow(int row,string caption,string value,color valueColor) =>
    color bg=row%2==0 ? dashboardAlt : dashboardBg
    table.cell(researchDashboard,0,row,caption,text_color=dashboardLabel,text_size=size.small,bgcolor=bg)
    table.cell(researchDashboard,1,row,value,text_color=valueColor,text_size=size.small,bgcolor=bg)
if barstate.islast
    table.clear(researchDashboard,0,0,1,9)
    table.set_position(researchDashboard,dashboardAnchor)
    if showDashboard and dashboardMode!="Off"
        table.cell(researchDashboard,0,0,"SECTOR PULSE V1",text_color=color.white,text_size=size.small,bgcolor=color.rgb(41,38,32))
        table.cell(researchDashboard,1,0,"RESEARCH COPY",text_color=color.rgb(221,194,139),text_size=size.small,bgcolor=color.rgb(41,38,32))
        f_dashboardRow(1,"MARKET REGIME",inferenceActive ? inferredRegime : "UNVERIFIED",inferenceActive ? f_inferredColor(inferredBullVotes-inferredBearVotes) : dashboardPending)
        f_dashboardRow(2,"TREND STATE",inferenceActive ? inferredTrendState==1 ? "BULLISH" : inferredTrendState==-1 ? "BEARISH" : "NEUTRAL" : "UNVERIFIED",inferenceActive ? f_inferredColor(inferredTrendState) : dashboardPending)
        f_dashboardRow(3,"PULSE DIRECTION",inferenceActive ? inferredDirection==1 ? "RISING" : inferredDirection==-1 ? "FALLING" : "FLAT" : "UNVERIFIED",inferenceActive ? f_inferredColor(inferredDirection) : dashboardPending)
        f_dashboardRow(4,"TREND ALIGNMENT",inferenceActive ? str.tostring(inferredVoteCount)+"/3" : "UNVERIFIED",inferenceActive ? f_inferredColor(inferredBullVotes-inferredBearVotes) : dashboardPending)
        if dashboardMode=="Detailed"
            string structure=na(sh) or na(sl) ? "UNAVAILABLE" : close>sh ? "BULLISH" : close<sl ? "BEARISH" : "INSIDE BAND"
            f_dashboardRow(5,"SMA STRUCTURE",structure,na(sh) or na(sl) ? dashboardLabel : sc)
            f_dashboardRow(6,"VOLATILITY","UNVERIFIED",dashboardPending)
            f_dashboardRow(7,"PRICE EFFICIENCY","UNVERIFIED",dashboardPending)
            f_dashboardRow(8,"CHART TYPE",chart.is_renko ? "BRICK" : "CANDLES / OTHER",dashboardLabel)
            f_dashboardRow(9,"STATUS",barstate.isconfirmed ? "CONFIRMED" : "FORMING",dashboardLabel)

// MERGED SHADOW CANDLE — standalone revision60 full table and ranges

string sc_gSource = "SC — Source and session"
string sc_market = input.string("Auto", "Market classification", options=["Auto", "NSE/BSE", "Foreign gold", "MCX", "Crypto", "Manual"], group=sc_gSource, display=display.none)
string sc_manualTf = input.timeframe("360", "Manual reference timeframe", group=sc_gSource, display=display.none)
string sc_sourceSession = input.string("Chart", "Source trading session", options=["Chart", "Regular", "Extended"], group=sc_gSource, display=display.none)
string sc_boundary = input.string("Exchange trading day", "Daily boundary", options=["Exchange trading day", "Custom daily reset"], group=sc_gSource, display=display.none)
string sc_zone = input.string("Etc/UTC", "Custom reset timezone (IANA)", group=sc_gSource, display=display.none)
int sc_resetHour = input.int(0, "Custom reset hour", minval=0, maxval=23, group=sc_gSource, display=display.none)
int sc_resetMinute = input.int(0, "Custom reset minute", minval=0, maxval=59, group=sc_gSource, display=display.none)
string sc_gLevels = "Range levels — measured upward from low"
float sc_p1 = 44.0
float sc_p2 = 50.0
float sc_p3 = 56.0
int sc_keep = input.int(30, "Completed sessions to retain", minval=1, maxval=30, group="SC — Display", display=display.none)
bool sc_showFinal = input.bool(true, "Plot Shadow Candle", group="SC — Display", display=display.none)
bool sc_showFull = input.bool(false, "Also plot complete reference-candle range", group="SC — Display", display=display.none)
bool sc_showLabels = input.bool(true, "Show SC label", group="SC — Display", display=display.none)
int sc_labelOffset = input.int(3, "SC label offset (future bars)", minval=1, maxval=20, group="SC — Display", display=display.none)
bool sc_showSourceBoxes = input.bool(true, "Box source candle on lower timeframes", group="SC — Display", display=display.none)
color sc_sourceBoxColor = input.color(color.rgb(99, 102, 241), "Source candle box", group="SC — Display", display=display.none)
int sc_sourceBoxTransparency = input.int(90, "Source box transparency (%)", minval=70, maxval=98, group="SC — Display", display=display.none)
bool sc_showSourceMarkers = input.bool(false, "Show historical source markers", group="SC — Display", display=display.none)
bool sc_showPanel = input.bool(true, "Show full Shadow Candle table", group="SC — Display", display=display.none)
bool sc_showGradient = input.bool(true, "Gradient fill inside closing-candle range", group="SC — Display", display=display.none)
int sc_fillOpacity = input.int(88, "Gradient transparency near middle (%)", minval=70, maxval=98, group="SC — Display", display=display.none)
color sc_bullColor = input.color(color.rgb(22, 163, 74), "Bullish zone", group="SC — Display", display=display.none)
color sc_bearColor = input.color(color.rgb(220, 38, 38), "Bearish zone", group="SC — Display", display=display.none)
string sc_gRsi = "SC — RSI SMA price-cross threshold"
bool sc_showRsiAverage = input.bool(true, "Show RSI SMA crossover price", group=sc_gRsi, display=display.none)
int sc_rsiLength = input.int(14, "RSI length", minval=2, group=sc_gRsi, display=display.none)
int sc_rsiSmaLength = input.int(14, "RSI SMA length", minval=1, group=sc_gRsi, display=display.none)
color sc_rsiAverageColor = input.color(color.rgb(168, 85, 247), "RSI SMA line", group=sc_gRsi, display=display.none)
bool sc_showGap = input.bool(true, "Previous close / day open gap Fib", group="SC — Gap Fibonacci", display=display.none)
color sc_gapColor = input.color(color.rgb(217, 119, 6), "Gap levels and fill", group="SC — Gap Fibonacci", display=display.none)
string sc_gPrevious = "SC — Previous completed periods"
bool sc_showPreviousDay = input.bool(true, "Previous day high / low", group=sc_gPrevious, display=display.none)
bool sc_showPreviousWeek = input.bool(true, "Previous week high / low", group=sc_gPrevious, display=display.none)
bool sc_showPreviousMonth = input.bool(true, "Previous month high / low", group=sc_gPrevious, display=display.none)
color sc_dayColor = input.color(color.rgb(79, 70, 229), "Daily levels", group=sc_gPrevious, display=display.none)
color sc_weekColor = input.color(color.rgb(14, 116, 144), "Weekly levels", group=sc_gPrevious, display=display.none)
color sc_monthColor = input.color(color.rgb(147, 51, 234), "Monthly levels", group=sc_gPrevious, display=display.none)
color sc_edge = input.color(color.silver, "High / low", group="SC — Display", display=display.none)
color sc_c1 = input.color(color.orange, "Level 1", group="SC — Display", display=display.none)
color sc_c2 = input.color(color.yellow, "Level 2", group="SC — Display", display=display.none)
color sc_c3 = input.color(color.aqua, "Level 3", group="SC — Display", display=display.none)
bool sc_showHistoricalSc = input.bool(true, "Show historical SC levels", group="SC — Display", tooltip="Show older Shadow Candle levels, range fills, source boxes and SC labels. The latest Shadow Candle stays visible. History and breakout target calculations remain active.", display=display.none)
bool sc_enableRsiOverlay = input.bool(true, "Show RSI readings in table", group=sc_gRsi, tooltip="Display latest completed 5m, 15m and 30m RSI / RSI SMA readings in the table. The V1 RSI price overlay retains its separate switch.", display=display.none)

string sc_gRedBars = "SC — 5-minute X / red / blended ranges"
bool sc_enableRedBars = input.bool(true, "Enable 5-minute candle ranges", group=sc_gRedBars, tooltip="Four separate confirmed ranges: first regular-session 5m X; next red 5m candle; All markets: six-candle 12:30–13:00 IST blend; all markets except NSE/BSE: six-candle 17:30–18:00 IST blend. All new candle-range times are IST. No reversal signals.", display=display.none)
bool sc_showRangeLabels = input.bool(true, "Show X / R / M / E source labels", group=sc_gRedBars, display=display.none)
int sc_redHistory = input.int(12, "Candle-range sessions to retain", minval=1, maxval=36, group=sc_gRedBars, tooltip="Separate from SC history. The effective limit is the smaller of this setting, SC retention and available Pine drawing capacity. Effective limit appears in each X/R/M tooltip. Oldest complete sessions are removed first.", display=display.none)
bool sc_showRedHistory = input.bool(false, "Show prior-session candle ranges", group=sc_gRedBars, tooltip="Keep the latest session readable. ON also displays retained older X/R/M/E ranges; calculations and archive remain active while OFF.", display=display.none)
int sc_scTargetPage = input.int(1, "SC target table page", minval=1, maxval=20, group="SC — Display", tooltip="The latest base SC is always pinned first. Revealed historical targets from the current breakout chain are ordered by reveal time, two per page. The table displays page/count when more targets exist; no target is silently discarded.", display=display.none)
int sc_rbReservedLines = sc_keep * (5 * ((sc_showFinal ? 1 : 0) + (sc_showFull ? 1 : 0)) + 1) + 11
int sc_rbKeep = math.max(1, math.min(sc_redHistory, sc_keep, int(math.floor((330-sc_rbReservedLines)/12.0))))

string sc_symbolText = str.upper(syminfo.ticker)
string sc_prefix = str.upper(syminfo.prefix)
bool sc_gold = str.contains(sc_symbolText, "GOLD") or str.contains(sc_symbolText, "XAU")
bool sc_crypto = syminfo.type == "crypto" or sc_prefix == "DELTAIN"
bool sc_indian = sc_prefix == "NSE" or sc_prefix == "BSE"
bool sc_mcx = str.contains(sc_prefix, "MCX")
string sc_autoMarket = sc_mcx ? "MCX" : sc_indian ? "NSE/BSE" : sc_gold ? "Foreign gold" : sc_crypto ? "Crypto" : "Unknown"
string sc_selected = sc_market == "Auto" ? sc_autoMarket : sc_market
string sc_refTf = sc_selected == "Foreign gold" ? "1320" : sc_selected == "Crypto" ? "1380" : sc_selected == "MCX" ? "840" : sc_selected == "NSE/BSE" ? "360" : sc_manualTf
bool sc_supported = chart.is_standard and timeframe.isintraday and timeframe.in_seconds() <= timeframe.in_seconds(sc_refTf) and sc_selected != "Unknown"
sc_showFinal := sc_showFinal and sc_supported
sc_showFull := sc_showFull and sc_supported

// The custom boundary groups native HTF bars; it does not re-anchor their openings.
sc_customKey(int sc_t) =>
    int sc_y = year(sc_t, sc_zone)
    int sc_m = month(sc_t, sc_zone)
    int sc_d = dayofmonth(sc_t, sc_zone)
    int sc_today = timestamp(sc_zone, sc_y, sc_m, sc_d, sc_resetHour, sc_resetMinute)
    sc_t >= sc_today ? sc_today : timestamp(sc_zone, sc_y, sc_m, sc_d - 1, sc_resetHour, sc_resetMinute)

sc_source() =>
    int sc_key = sc_boundary == "Exchange trading day" ? time_tradingday : sc_customKey(time)
    var float sc_fullH = na
    var float sc_fullL = na
    var int sc_fullT = na
    var int sc_fullC = na
    if na(sc_key[1]) or sc_key != sc_key[1]
        sc_fullH := na
        sc_fullL := na
        sc_fullT := na
        sc_fullC := na
    if time_close - time >= timeframe.in_seconds() * 1000
        sc_fullH := high
        sc_fullL := low
        sc_fullT := time
        sc_fullC := time_close
    // Only previous-bar prices/state leave the reference context.
    [high[1], low[1], time[1], time_close[1], time_close("1D")[1], sc_key[1], sc_key, sc_fullH[1], sc_fullL[1], sc_fullT[1], sc_fullC[1], open[1], close[1]]

string sc_requestTicker = ticker.new(syminfo.prefix, syminfo.ticker, sc_sourceSession == "Regular" ? session.regular : sc_sourceSession == "Extended" ? session.extended : syminfo.session)
[sc_h, sc_l, sc_sourceOpen, sc_sourceClose, sc_scheduledClose, sc_priorKey, sc_currentKey, sc_fullHigh, sc_fullLow, sc_fullOpen, sc_fullClose, sc_sourceOhlcOpen, sc_sourceOhlcClose] = request.security(sc_requestTicker, sc_refTf, sc_source(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
// Publish the just-completed session-end reference candle immediately.
// lookahead_off exposes it only at its closing chart bar; chart confirmation
// prevents forming ticks from committing candidate OHLC or replacing the prior set.
[sc_closeH, sc_closeL, sc_closeO, sc_closeC, sc_closeT, sc_closeEnd, sc_closeScheduled] = request.security(sc_requestTicker, sc_refTf, [high, low, open, close, time, time_close, time_close("1D")], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
bool sc_candidateAtSessionEnd = sc_boundary == "Exchange trading day" ? sc_closeEnd == sc_closeScheduled : sc_closeEnd == sc_customKey(sc_closeEnd)
// A feed can end its final lower-timeframe bar before the native reference
// interval's scheduled endpoint. Release the fully elapsed candle only on
// the confirmed final session bar of the dataset, never on forming history.
[sc_endH, sc_endL, sc_endO, sc_endC, sc_endT, sc_endClose, sc_endScheduled] = request.security(sc_requestTicker, sc_refTf, [high, low, open, close, time, time_close, time_close("1D")], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
bool sc_endAtSessionEnd = sc_boundary == "Exchange trading day" ? sc_endClose == sc_endScheduled : sc_endClose == sc_customKey(sc_endClose)
bool sc_elapsedFinalHistory = barstate.islastconfirmedhistory and sc_endClose <= timenow and sc_endScheduled <= timenow and time >= sc_endT and time_close <= sc_endClose and sc_endAtSessionEnd and sc_endClose-sc_endT < timeframe.in_seconds(sc_refTf)*1000
if sc_elapsedFinalHistory
    sc_closeH := sc_endH
    sc_closeL := sc_endL
    sc_closeO := sc_endO
    sc_closeC := sc_endC
    sc_closeT := sc_endT
    sc_closeEnd := sc_endClose
    sc_closeScheduled := sc_endScheduled
bool sc_confirmedFinalNow = sc_elapsedFinalHistory or (barstate.isconfirmed and time_close == sc_closeEnd and sc_closeEnd <= timenow and sc_candidateAtSessionEnd and sc_closeEnd-sc_closeT < timeframe.in_seconds(sc_refTf)*1000)
if sc_confirmedFinalNow
    sc_h := sc_closeH
    sc_l := sc_closeL
    sc_sourceOpen := sc_closeT
    sc_sourceClose := sc_closeEnd
    sc_scheduledClose := sc_closeScheduled
    sc_sourceOhlcOpen := sc_closeO
    sc_sourceOhlcClose := sc_closeC
bool sc_finalBar = sc_confirmedFinalNow or (not na(sc_priorKey) and sc_priorKey != sc_currentKey)
bool sc_atClose = sc_confirmedFinalNow or (sc_boundary == "Exchange trading day" ? sc_sourceClose == sc_scheduledClose : sc_sourceClose == sc_currentKey)
bool sc_shortened = sc_sourceClose - sc_sourceOpen < timeframe.in_seconds(sc_refTf) * 1000
bool sc_validFinal = sc_atClose and sc_shortened
var int sc_lastSource = na
var bool sc_missingFinal = false
var int sc_lockedClose = na
var int sc_lockedScheduled = na
var float sc_lockedHigh = na
var float sc_lockedLow = na
var float sc_lockedFullHigh = na
var float sc_lockedFullLow = na
var int sc_lockedFullOpen = na
var int sc_lockedFullClose = na
var array<box> sc_sourceBoxes = array.new<box>()
var array<line> sc_finalLines = array.new<line>()
var array<line> sc_fullLines = array.new<line>()
var array<line> sc_activeFinal = array.new<line>()
var array<line> sc_activeFull = array.new<line>()
var array<label> sc_labels = array.new<label>()
var label sc_rangeTag = na
var line sc_tagLeader = na
// One retained record, label and leader per confirmed source candle.
type sc_SCReference
    int sc_opened
    int sc_closed
    float sc_hi
    float sc_lo
    label sc_tag
    line sc_leader
    int sc_visitedChain
    int sc_approach
    bool sc_broken
    int sc_anchorAt
    int sc_brokenAt
    int sc_brokenDirection
var array<sc_SCReference> sc_scArchive = array.new<sc_SCReference>()
var sc_SCReference sc_activeSc = na
var int sc_scChainKey = na
// Each color segment is frozen at its own confirmed close; old segments never change regime.
type sc_ZoneBand
    int sourceKey
    int sc_startTime
    int sc_endTime
    float sc_hi
    float sc_lo
    color sc_tint
    array<box> sc_layers
var array<sc_ZoneBand> sc_bandHistory = array.new<sc_ZoneBand>()
var array<int> sc_sessionHistory = array.new<int>()
var sc_ZoneBand sc_currentBand = na
var int sc_regime = 0

sc_zoneColor(int sc_state) =>
    sc_state > 0 ? sc_bullColor : sc_state < 0 ? sc_bearColor : sc_c2

sc_deleteBand(sc_ZoneBand sc_band) =>
    for sc_layer in sc_band.sc_layers
        box.delete(sc_layer)
    array.clear(sc_band.sc_layers)

sc_endBand(sc_ZoneBand sc_band, int sc_ended) =>
    sc_band.sc_endTime := sc_ended
    for sc_layer in sc_band.sc_layers
        box.set_right(sc_layer, sc_ended)

sc_makeBand(int sc_started, int sc_key, float sc_hi, float sc_lo, int sc_state) =>
    int sc_boxCount = 0
    for sc_prior in sc_bandHistory
        sc_boxCount += array.size(sc_prior.sc_layers)
    // Compact the oldest gradients to their SAME state tint before approaching TV's object cap.
    // This changes only gradient resolution, never the recorded bullish/bearish timing.
    while sc_boxCount > 100
        bool sc_compacted = false
        for sc_prior in sc_bandHistory
            int sc_count = array.size(sc_prior.sc_layers)
            if sc_count > 1
                sc_deleteBand(sc_prior)
                array.push(sc_prior.sc_layers, box.new(sc_prior.sc_startTime, sc_prior.sc_hi, sc_prior.sc_endTime, sc_prior.sc_lo, xloc=xloc.bar_time, border_color=na, bgcolor=color.new(sc_prior.sc_tint, sc_fillOpacity)))
                sc_boxCount -= sc_count - 1
                sc_compacted := true
                break
        if not sc_compacted
            sc_ZoneBand sc_oldest = array.shift(sc_bandHistory)
            sc_boxCount -= array.size(sc_oldest.sc_layers)
            sc_deleteBand(sc_oldest)
    color sc_tint = sc_zoneColor(sc_state)
    sc_ZoneBand sc_band = sc_ZoneBand.new(sc_key, sc_started, sc_started, sc_hi, sc_lo, sc_tint, array.new<box>())
    for sc_slice = 0 to 11
        float sc_a = sc_slice * 100.0 / 12
        float sc_b = (sc_slice+1) * 100.0 / 12
        float sc_mid = (sc_a+sc_b)/2
        color sc_bottomColor = sc_state == 0 ? sc_c1 : sc_tint
        color sc_topColor = sc_state == 0 ? sc_c3 : sc_tint
        color sc_shade = sc_mid <= sc_p2 ? color.from_gradient(sc_mid, 0, sc_p2, color.new(sc_bottomColor, 98), color.new(sc_tint, sc_fillOpacity)) : color.from_gradient(sc_mid, sc_p2, 100, color.new(sc_tint, sc_fillOpacity), color.new(sc_topColor, 98))
        array.push(sc_band.sc_layers, box.new(sc_started, sc_lo+(sc_hi-sc_lo)*sc_b/100, sc_started, sc_lo+(sc_hi-sc_lo)*sc_a/100, xloc=xloc.bar_time, border_color=na, bgcolor=sc_shade))
    array.push(sc_bandHistory, sc_band)
    sc_band

sc_finishSet(array<line> sc_active) =>
    if array.size(sc_active) > 0
        for sc_ln in sc_active
            line.set_x2(sc_ln, sc_confirmedFinalNow ? sc_sourceClose : time)
    array.clear(sc_active)

sc_drawSet(float sc_hi, float sc_lo, int sc_opened, int sc_closed, bool sc_complete, array<line> sc_history, array<line> sc_active) =>
    array<float> sc_prices = array.from(sc_hi, sc_lo, sc_lo + (sc_hi-sc_lo)*sc_p1/100, sc_lo + (sc_hi-sc_lo)*sc_p2/100, sc_lo + (sc_hi-sc_lo)*sc_p3/100)
    array<color> sc_colors = array.from(sc_edge, sc_edge, sc_c1, sc_c2, sc_c3)
    for sc_i = 0 to 4
        color sc_col = sc_complete ? color.new(array.get(sc_colors, sc_i), 45) : array.get(sc_colors, sc_i)
        int sc_publishedAt = sc_confirmedFinalNow ? sc_closed : time
        int sc_displayedUntil = barstate.islast ? time_close + int(timeframe.in_seconds()*1000)*sc_labelOffset : time_close
        line sc_ln = line.new(sc_publishedAt, array.get(sc_prices, sc_i), sc_displayedUntil, array.get(sc_prices, sc_i), xloc=xloc.bar_time, color=sc_col, width=sc_i < 2 ? 2 : 1, style=sc_complete ? line.style_dashed : line.style_solid)
        array.push(sc_history, sc_ln)
        array.push(sc_active, sc_ln)
    if sc_showSourceMarkers
        string sc_identity = sc_complete ? "Complete " + sc_refTf + "m reference candle" : "Shadow Candle"
        string sc_labelText = sc_identity + "\n" + str.format_time(sc_opened, "dd MMM HH:mm", syminfo.timezone) + " → " + str.format_time(sc_closed, "dd MMM HH:mm", syminfo.timezone) + "\nH " + str.tostring(sc_hi, "#.##") + "  L " + str.tostring(sc_lo, "#.##") + "\n" + str.tostring(sc_p1, "#.##") + "% " + str.tostring(sc_lo + (sc_hi-sc_lo)*sc_p1/100, "#.##") + " | " + str.tostring(sc_p2, "#.##") + "% " + str.tostring(sc_lo + (sc_hi-sc_lo)*sc_p2/100, "#.##") + " | " + str.tostring(sc_p3, "#.##") + "% " + str.tostring(sc_lo + (sc_hi-sc_lo)*sc_p3/100, "#.##")
        array.push(sc_labels, label.new(time, sc_lo, "", xloc=xloc.bar_time, style=label.style_circle, color=sc_complete ? color.new(color.purple, 25) : color.new(color.rgb(30, 41, 59), 15), textcolor=color.white, size=size.tiny, tooltip=sc_labelText))
    while array.size(sc_history) > sc_keep * 5
        line.delete(array.shift(sc_history))
    while array.size(sc_labels) > sc_keep * (sc_showFinal and sc_showFull ? 2 : 1)
        label.delete(array.shift(sc_labels))

sc_scDetails(sc_SCReference sc_sc) =>
    "Historical Shadow Candle\n" + str.format_time(sc_sc.sc_opened, "dd MMM yyyy HH:mm", syminfo.timezone) + "–" + str.format_time(sc_sc.sc_closed, "HH:mm", syminfo.timezone) + "\nHigh " + str.tostring(sc_sc.sc_hi, "#.##") + " · Low " + str.tostring(sc_sc.sc_lo, "#.##")

sc_freezeSc(sc_SCReference sc_sc, int sc_ended) =>
    if not na(sc_sc.sc_tag)
        label.set_x(sc_sc.sc_tag, sc_ended)
    if not na(sc_sc.sc_leader)
        line.set_x2(sc_sc.sc_leader, sc_ended)

sc_revealSc(sc_SCReference sc_sc, int sc_direction, int sc_started) =>
    sc_sc.sc_approach := sc_direction
    sc_sc.sc_anchorAt := sc_started
    sc_sc.sc_broken := false
    sc_sc.sc_brokenAt := na
    sc_sc.sc_brokenDirection := 0
    int sc_future = sc_started + int(timeframe.in_seconds()*1000)*sc_labelOffset
    color sc_tint = sc_direction > 0 ? sc_bullColor : sc_bearColor
    string sc_caption = "SC " + (sc_direction > 0 ? "↑ " : "↓ ") + str.format_time(sc_sc.sc_opened, "dd MMM", syminfo.timezone)
    string sc_details = sc_scDetails(sc_sc) + "\nRevealed after confirmed " + (sc_direction > 0 ? "upward" : "downward") + " break at " + str.format_time(sc_started, "dd MMM HH:mm", syminfo.timezone) + "\nNearest archived range still beyond the breakout close; original SC retained."
    if sc_showLabels
        if na(sc_sc.sc_tag)
            sc_sc.sc_tag := label.new(sc_future, sc_sc.sc_lo, sc_caption, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(sc_tint, 10), textcolor=color.white, size=size.tiny, tooltip=sc_details)
        else
            label.set_xy(sc_sc.sc_tag, sc_future, sc_sc.sc_lo)
            label.set_text(sc_sc.sc_tag, sc_caption)
            label.set_color(sc_sc.sc_tag, color.new(sc_tint, 10))
            label.set_tooltip(sc_sc.sc_tag, sc_details)
    if na(sc_sc.sc_leader)
        sc_sc.sc_leader := line.new(sc_started, sc_sc.sc_lo, sc_future, sc_sc.sc_lo, xloc=xloc.bar_time, color=sc_tint, style=line.style_dotted)
    else
        line.set_xy1(sc_sc.sc_leader, sc_started, sc_sc.sc_lo)
        line.set_xy2(sc_sc.sc_leader, sc_future, sc_sc.sc_lo)
        line.set_color(sc_sc.sc_leader, sc_tint)
    sc_sc

// Advance SC targets only from completed native 5m events on every chart.
sc_scAdvance(sc_SCReference sc_initialSc, float sc_sourcePrice, int sc_ended) =>
    sc_SCReference sc_currentSc = sc_initialSc
    if sc_showFinal and not na(sc_currentSc) and not na(sc_ended) and sc_ended > sc_currentSc.sc_anchorAt
        if not sc_currentSc.sc_broken
            int sc_direction = sc_currentSc.sc_approach >= 0 and sc_sourcePrice > sc_currentSc.sc_hi ? 1 : sc_currentSc.sc_approach <= 0 and sc_sourcePrice < sc_currentSc.sc_lo ? -1 : 0
            if sc_direction != 0
                sc_currentSc.sc_broken := true
                sc_currentSc.sc_brokenAt := sc_ended
                sc_currentSc.sc_brokenDirection := sc_direction
                sc_freezeSc(sc_currentSc, sc_ended)
                if not na(sc_currentSc.sc_tag)
                    label.set_tooltip(sc_currentSc.sc_tag, sc_scDetails(sc_currentSc) + "\nBroken " + (sc_direction > 0 ? "above" : "below") + " on confirmed 5m close " + str.format_time(sc_ended, "dd MMM HH:mm", syminfo.timezone) + "\nThis original SC is retained.")
                sc_SCReference sc_nextSc = na
                float sc_nearest = na
                for sc_candidate in sc_scArchive
                    bool sc_unvisited = na(sc_candidate.sc_visitedChain) or sc_candidate.sc_visitedChain != sc_scChainKey
                    bool sc_older = sc_candidate.sc_opened < sc_scChainKey
                    bool sc_ahead = sc_direction > 0 ? sc_candidate.sc_lo > sc_sourcePrice : sc_candidate.sc_hi < sc_sourcePrice
                    if sc_older and sc_unvisited and sc_ahead
                        float sc_distance = sc_direction > 0 ? sc_candidate.sc_lo-sc_sourcePrice : sc_sourcePrice-sc_candidate.sc_hi
                        if na(sc_nearest) or sc_distance <= sc_nearest
                            sc_nearest := sc_distance
                            sc_nextSc := sc_candidate
                if not na(sc_nextSc)
                    sc_nextSc.sc_visitedChain := sc_scChainKey
                    sc_revealSc(sc_nextSc, sc_direction, sc_ended)
                    sc_currentSc := sc_nextSc
    sc_currentSc

if sc_finalBar and (na(sc_lastSource) or sc_sourceOpen != sc_lastSource)
    sc_SCReference sc_freshSc = na
    sc_lastSource := sc_sourceOpen
    sc_missingFinal := not sc_validFinal
    sc_lockedClose := sc_sourceClose
    sc_lockedScheduled := sc_scheduledClose
    sc_lockedHigh := sc_validFinal ? sc_h : na
    sc_lockedLow := sc_validFinal ? sc_l : na
    sc_lockedFullHigh := sc_fullHigh
    sc_lockedFullLow := sc_fullLow
    sc_lockedFullOpen := sc_fullOpen
    sc_lockedFullClose := sc_fullClose
    if not na(sc_currentBand)
        sc_endBand(sc_currentBand, sc_confirmedFinalNow ? sc_sourceClose : time)
    sc_currentBand := na
    sc_regime := 0
    array.push(sc_sessionHistory, sc_sourceOpen)
    while array.size(sc_sessionHistory) > sc_keep
        array.shift(sc_sessionHistory)
    while array.size(sc_bandHistory) > 0
        sc_ZoneBand sc_oldest = array.get(sc_bandHistory, 0)
        if sc_oldest.sourceKey < array.get(sc_sessionHistory, 0)
            sc_deleteBand(array.shift(sc_bandHistory))
        else
            break
    // Retire the active pointer without deleting its retained source label.
    if not na(sc_activeSc)
        sc_freezeSc(sc_activeSc, sc_confirmedFinalNow ? sc_sourceClose : time)
    sc_rangeTag := na
    sc_tagLeader := na
    sc_activeSc := na
    if sc_validFinal
        sc_scChainKey := sc_sourceOpen
        sc_freshSc := sc_SCReference.new(sc_sourceOpen, sc_sourceClose, sc_h, sc_l, na, na, sc_scChainKey, 0, false, sc_sourceClose, na, 0)
        array.push(sc_scArchive, sc_freshSc)
        sc_activeSc := sc_freshSc
    while array.size(sc_scArchive) > sc_keep
        sc_SCReference sc_expired = array.shift(sc_scArchive)
        if not na(sc_expired.sc_tag)
            label.delete(sc_expired.sc_tag)
        if not na(sc_expired.sc_leader)
            line.delete(sc_expired.sc_leader)
    sc_finishSet(sc_activeFinal)
    sc_finishSet(sc_activeFull)
    // Confirmed source bounds, drawn back over ONLY its constituent chart candles.
    if sc_showSourceBoxes and sc_validFinal and timeframe.in_seconds() <= timeframe.in_seconds(sc_refTf)
        // Native reference OHLC equals the blended constituent-candle group.
        // Freeze its OWN direction; later breakout regimes never recolor this source box.
        color sc_sourceTint = sc_sourceOhlcClose > sc_sourceOhlcOpen ? sc_bullColor : sc_sourceOhlcClose < sc_sourceOhlcOpen ? sc_bearColor : sc_sourceBoxColor
        array.push(sc_sourceBoxes, box.new(sc_sourceOpen, sc_h, sc_sourceClose, sc_l, xloc=xloc.bar_time, border_color=color.new(sc_sourceTint, 35), border_width=1, bgcolor=color.new(sc_sourceTint, sc_sourceBoxTransparency)))
        while array.size(sc_sourceBoxes) > sc_keep
            box.delete(array.shift(sc_sourceBoxes))
    if sc_showFinal and sc_validFinal
        sc_drawSet(sc_h, sc_l, sc_sourceOpen, sc_sourceClose, false, sc_finalLines, sc_activeFinal)
        if sc_showGradient
            sc_currentBand := sc_makeBand(sc_confirmedFinalNow ? sc_sourceClose : time, sc_sourceOpen, sc_h, sc_l, 0)
        if sc_showLabels
            string sc_details = "Shadow Candle\n" + str.format_time(sc_sourceOpen, "dd MMM HH:mm", syminfo.timezone) + "–" + str.format_time(sc_sourceClose, "HH:mm", syminfo.timezone) + "\nBlended O " + str.tostring(sc_sourceOhlcOpen, "#.##") + " · C " + str.tostring(sc_sourceOhlcClose, "#.##") + "\nHigh " + str.tostring(sc_h, "#.##") + " · Low " + str.tostring(sc_l, "#.##")
            sc_rangeTag := label.new(time_close, sc_l, "SC", xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.rgb(30, 41, 59), 10), textcolor=color.white, size=size.tiny, tooltip=sc_details)
            sc_tagLeader := line.new(time_close, sc_l, time_close, sc_l, xloc=xloc.bar_time, color=sc_edge, style=line.style_dotted)
            sc_freshSc.sc_tag := sc_rangeTag
            sc_freshSc.sc_leader := sc_tagLeader
            label.set_text(sc_rangeTag, "SC · " + str.format_time(sc_sourceOpen, "dd MMM", syminfo.timezone))
    if sc_showFull and not na(sc_fullHigh)
        sc_drawSet(sc_fullHigh, sc_fullLow, sc_fullOpen, sc_fullClose, true, sc_fullLines, sc_activeFull)
// Use chart-bar confirmation outside request.security. Forming ticks cannot change regime.
// A transition begins at time_close; the earlier portion of this bar/session is untouched.
if not na(sc_currentBand)
    sc_endBand(sc_currentBand, time_close)
if sc_showFinal and not sc_missingFinal and not na(sc_lockedHigh) and barstate.isconfirmed
    int sc_nextRegime = close > sc_lockedHigh ? 1 : close < sc_lockedLow ? -1 : 0
    if sc_nextRegime != sc_regime
        if not na(sc_currentBand)
            sc_endBand(sc_currentBand, time_close)
        sc_regime := sc_nextRegime
        if sc_showGradient
            sc_currentBand := sc_makeBand(time_close, sc_lastSource, sc_lockedHigh, sc_lockedLow, sc_regime)
// Only the current SC advances. Earlier SC labels/levels remain frozen.
if not na(sc_activeSc) and sc_showFinal
    if not sc_activeSc.sc_broken
        int sc_labelTime = time_close + int(timeframe.in_seconds()*1000)*sc_labelOffset
        if sc_showLabels and not na(sc_activeSc.sc_tag)
            label.set_xy(sc_activeSc.sc_tag, sc_labelTime, sc_activeSc.sc_lo)
        if not na(sc_activeSc.sc_leader)
            line.set_xy1(sc_activeSc.sc_leader, sc_activeSc.sc_anchorAt, sc_activeSc.sc_lo)
            line.set_xy2(sc_activeSc.sc_leader, sc_labelTime, sc_activeSc.sc_lo)
        if sc_activeSc.sc_approach == 0
            color sc_tint = sc_regime == 0 ? color.rgb(30, 41, 59) : sc_zoneColor(sc_regime)
            if not na(sc_activeSc.sc_tag)
                label.set_color(sc_activeSc.sc_tag, color.new(sc_tint, 10))
            if not na(sc_activeSc.sc_leader)
                line.set_color(sc_activeSc.sc_leader, sc_regime == 0 ? sc_edge : sc_tint)
if array.size(sc_activeFinal) > 0
    for sc_ln in sc_activeFinal
        line.set_x2(sc_ln, barstate.islast ? time_close + int(timeframe.in_seconds()*1000)*sc_labelOffset : time_close)
if array.size(sc_activeFull) > 0
    for sc_ln in sc_activeFull
        line.set_x2(sc_ln, barstate.islast ? time_close + int(timeframe.in_seconds()*1000)*sc_labelOffset : time_close)


// Confirmed prior exchange candles. Current-period time is calendar metadata only.
// Daily means previous TRADING session, weekly/monthly mean completed exchange periods.
[sc_pdh, sc_pdl, sc_daySource, sc_dayStart] = request.security(sc_requestTicker, "1D", [high[1], low[1], time[1], time], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[sc_pwh, sc_pwl, sc_weekSource, sc_weekStart] = request.security(sc_requestTicker, "1W", [high[1], low[1], time[1], time], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[sc_pmh, sc_pml, sc_monthSource, sc_monthStart] = request.security(sc_requestTicker, "1M", [high[1], low[1], time[1], time], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
var array<line> sc_periodLines = array.new<line>(6, na)
var array<label> sc_periodTags = array.new<label>(6, na)
array<float> sc_periodPrices = array.from(sc_pdh, sc_pdl, sc_pwh, sc_pwl, sc_pmh, sc_pml)
array<int> sc_periodStarts = array.from(sc_dayStart, sc_dayStart, sc_weekStart, sc_weekStart, sc_monthStart, sc_monthStart)
array<int> sc_sourceStarts = array.from(sc_daySource, sc_daySource, sc_weekSource, sc_weekSource, sc_monthSource, sc_monthSource)
array<string> sc_periodNames = array.from("PDH", "PDL", "PWH", "PWL", "PMH", "PML")
array<color> sc_periodColors = array.from(sc_dayColor, sc_dayColor, sc_weekColor, sc_weekColor, sc_monthColor, sc_monthColor)
array<bool> sc_enabledPeriods = array.from(sc_showPreviousDay, sc_showPreviousDay, sc_showPreviousWeek, sc_showPreviousWeek, sc_showPreviousMonth, sc_showPreviousMonth)
// Separate nearby labels horizontally; line/label price anchors are NEVER displaced.
float sc_upperPrice = na
float sc_lowerPrice = na
for sc_i = 0 to 5
    float sc_price = array.get(sc_periodPrices, sc_i)
    if array.get(sc_enabledPeriods, sc_i) and not na(sc_price)
        sc_upperPrice := na(sc_upperPrice) ? sc_price : math.max(sc_upperPrice, sc_price)
        sc_lowerPrice := na(sc_lowerPrice) ? sc_price : math.min(sc_lowerPrice, sc_price)
float sc_proximity = math.max((sc_upperPrice-sc_lowerPrice)*0.04, syminfo.mintick*10)
array<int> sc_lanes = array.new<int>(6, 0)
for sc_i = 0 to 5
    float sc_price = array.get(sc_periodPrices, sc_i)
    if array.get(sc_enabledPeriods, sc_i) and not na(sc_price)
        int sc_lane = sc_showLabels and sc_showFinal and not na(sc_lockedLow) and math.abs(sc_price-sc_lockedLow) < sc_proximity ? 1 : 0
        if sc_i > 0
            for sc_j = 0 to sc_i-1
                if array.get(sc_enabledPeriods, sc_j) and math.abs(sc_price-array.get(sc_periodPrices, sc_j)) < sc_proximity
                    sc_lane := math.max(sc_lane, array.get(sc_lanes, sc_j)+1)
        array.set(sc_lanes, sc_i, sc_lane)
        int sc_futureTime = time_close + int(timeframe.in_seconds()*1000)*(sc_labelOffset + sc_lane*24)
        line sc_periodLine = array.get(sc_periodLines, sc_i)
        label sc_periodTag = array.get(sc_periodTags, sc_i)
        color sc_tint = array.get(sc_periodColors, sc_i)
        string sc_caption = array.get(sc_periodNames, sc_i)
        string sc_detail = sc_caption + " · previous completed " + (sc_i < 2 ? "trading day" : sc_i < 4 ? "week" : "month") + "\nFrom " + str.format_time(array.get(sc_sourceStarts, sc_i), "dd MMM yyyy", syminfo.timezone) + "\n" + str.tostring(sc_price, "#,###.##")
        if na(sc_periodLine)
            sc_periodLine := line.new(array.get(sc_periodStarts, sc_i), sc_price, sc_futureTime, sc_price, xloc=xloc.bar_time, color=sc_tint, style=sc_i%2 == 0 ? line.style_dashed : line.style_dotted)
            sc_periodTag := label.new(bar_index + sc_labelOffset + sc_lane*24, sc_price, sc_caption, xloc=xloc.bar_index, style=label.style_label_left, color=sc_tint, textcolor=color.white, size=size.tiny, tooltip=sc_detail)
            array.set(sc_periodLines, sc_i, sc_periodLine)
            array.set(sc_periodTags, sc_i, sc_periodTag)
        else
            line.set_xy1(sc_periodLine, array.get(sc_periodStarts, sc_i), sc_price)
            line.set_xy2(sc_periodLine, sc_futureTime, sc_price)
            label.set_xy(sc_periodTag, bar_index + sc_labelOffset + sc_lane*24, sc_price)
            label.set_tooltip(sc_periodTag, sc_detail)

// Exchange daily endpoints are frozen: 0% previous close, 100% current day open.
[sc_previousClose, sc_dailyOpen, sc_gapStart] = request.security(sc_requestTicker, "1D", [close[1], open, time], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
var array<line> sc_gapLines = array.new<line>(5, na)
var array<label> sc_gapTags = array.new<label>(5, na)
var box sc_gapFill = na
if barstate.islast
    bool sc_hasGap = sc_showGap and not na(sc_previousClose) and not na(sc_dailyOpen) and math.abs(sc_dailyOpen-sc_previousClose) >= syminfo.mintick
    array<float> sc_gapRatios = array.from(0.0, 100.0, sc_p1, sc_p2, sc_p3)
    // Dedicated future columns keep the narrow gap Fib labels readable at true prices.
    for sc_i = 0 to 4
        line sc_gl = array.get(sc_gapLines, sc_i)
        label sc_gt = array.get(sc_gapTags, sc_i)
        if sc_hasGap
            float sc_ratio = array.get(sc_gapRatios, sc_i)
            float sc_price = sc_previousClose + (sc_dailyOpen-sc_previousClose)*sc_ratio/100
            int sc_labelBar = bar_index + sc_labelOffset + 48 + sc_i*10
            string sc_caption = sc_i == 0 ? "PDC" : sc_i == 1 ? "DO" : str.tostring(sc_ratio, "#.##") + "%"
            color sc_tint = sc_i < 2 ? sc_gapColor : sc_i == 2 ? sc_c1 : sc_i == 3 ? sc_c2 : sc_c3
            string sc_details = "Gap " + (sc_dailyOpen > sc_previousClose ? "up" : "down") + " · " + sc_caption + "\n" + str.tostring(sc_price, "#,###.##") + "\n0% previous trading-day close → 100% current exchange day open"
            if na(sc_gl)
                sc_gl := line.new(sc_gapStart, sc_price, time_close, sc_price, xloc=xloc.bar_time, color=color.new(sc_tint, 20), style=line.style_dashed)
                sc_gt := label.new(sc_labelBar, sc_price, sc_caption, xloc=xloc.bar_index, style=label.style_label_left, color=sc_tint, textcolor=color.white, size=size.tiny, tooltip=sc_details)
                array.set(sc_gapLines, sc_i, sc_gl)
                array.set(sc_gapTags, sc_i, sc_gt)
            else
                line.set_xy1(sc_gl, sc_gapStart, sc_price)
                line.set_xy2(sc_gl, time_close, sc_price)
                label.set_xy(sc_gt, sc_labelBar, sc_price)
                label.set_text(sc_gt, sc_caption)
                label.set_tooltip(sc_gt, sc_details)
        else
            line.delete(sc_gl)
            label.delete(sc_gt)
            array.set(sc_gapLines, sc_i, na)
            array.set(sc_gapTags, sc_i, na)
    if not na(sc_gapFill)
        box.delete(sc_gapFill)
        sc_gapFill := na
    if sc_hasGap
        sc_gapFill := box.new(sc_gapStart, math.max(sc_previousClose, sc_dailyOpen), time_close, math.min(sc_previousClose, sc_dailyOpen), xloc=xloc.bar_time, border_color=na, bgcolor=color.new(sc_gapColor, 94))

// Inverse Wilder RSI. RSI(c) == SMA(RSI(c), M) iff RSI(c) equals
// the average of the PREVIOUS M-1 RSI values. This target is fixed before this bar.
float sc_chartRsi = ta.rsi(close, sc_rsiLength)
float sc_rsiAverage = ta.sma(sc_chartRsi, sc_rsiSmaLength)
float sc_priorRsiTarget = ta.sma(sc_chartRsi[1], math.max(sc_rsiSmaLength-1, 1))
float sc_upState = ta.rma(math.max(ta.change(close), 0), sc_rsiLength)
float sc_downState = ta.rma(math.max(-ta.change(close), 0), sc_rsiLength)
float sc_priorGain = (sc_rsiLength-1)*sc_upState[1]
float sc_priorLoss = (sc_rsiLength-1)*sc_downState[1]
float sc_rsiCrossPrice = na
bool sc_invertibleRsi = sc_rsiSmaLength > 1 and not na(sc_priorRsiTarget) and sc_priorRsiTarget > 0 and sc_priorRsiTarget < 100 and not na(sc_priorGain) and not na(sc_priorLoss) and sc_priorGain+sc_priorLoss > 0
if sc_invertibleRsi
    float sc_targetRs = sc_priorRsiTarget/(100-sc_priorRsiTarget)
    float sc_delta = sc_priorGain <= sc_targetRs*sc_priorLoss ? sc_targetRs*sc_priorLoss-sc_priorGain : sc_priorLoss-sc_priorGain/sc_targetRs
    float sc_candidate = close[1]+sc_delta
    sc_rsiCrossPrice := sc_candidate > 0 ? sc_candidate : na
plot(sc_showRsiAverage ? sc_rsiCrossPrice : na, "RSI SMA crossover price", color=sc_rsiAverageColor, linewidth=2, style=plot.style_linebr)
plot(sc_showRsiAverage ? sc_chartRsi : na, "RSI · raw", display=display.data_window)
plot(sc_showRsiAverage ? sc_rsiAverage : na, "RSI SMA · raw", display=display.data_window)
// Read-only diagnostic in Data Window: zero means same-bar sides agree.
float sc_crossMismatch = not na(sc_rsiCrossPrice) and math.abs(sc_chartRsi-sc_rsiAverage) > 0.00000001 ? ((close > sc_rsiCrossPrice) == (sc_chartRsi > sc_rsiAverage) ? 0 : 1) : na
plot(sc_showRsiAverage ? sc_crossMismatch : na, "RSI cross-side mismatch (0 = match)", display=display.data_window)
var label sc_rsiTag = na
if barstate.islast
    if not na(sc_rsiTag)
        label.delete(sc_rsiTag)
        sc_rsiTag := na
    if sc_showRsiAverage
        string sc_details = "RSI " + str.tostring(sc_chartRsi, "#.##") + " · SMA " + str.tostring(sc_rsiAverage, "#.##") + "\n" + (not na(sc_rsiCrossPrice) ? "Close above/below this price means RSI above/below its SMA on this same chart candle. Threshold " + str.tostring(sc_rsiCrossPrice, "#.##") : "Threshold unavailable: warm-up, extreme RSI, flat states, SMA length 1, or no positive-price solution.") + "\nThis is an inverse-RSI crossover threshold; it does not reproduce the oscillator average's shape."
        sc_rsiTag := label.new(bar_index + sc_labelOffset + 12, not na(sc_rsiCrossPrice) ? sc_rsiCrossPrice : close, not na(sc_rsiCrossPrice) ? "RSI SMA" : "RSI SMA n/a", xloc=xloc.bar_index, style=label.style_label_left, color=color.new(sc_rsiAverageColor, 15), textcolor=color.white, size=size.tiny, tooltip=sc_details)

// Display-only history filter. Input changes recalculate original object colors.
if barstate.islast and not sc_showHistoricalSc
    for sc_ln in sc_finalLines
        if not array.includes(sc_activeFinal, sc_ln)
            line.set_color(sc_ln, na)
    for sc_ln in sc_fullLines
        if not array.includes(sc_activeFull, sc_ln)
            line.set_color(sc_ln, na)
    for sc_bx in sc_sourceBoxes
        if box.get_left(sc_bx) != sc_lastSource
            box.set_bgcolor(sc_bx, na)
            box.set_border_color(sc_bx, na)
    for sc_band in sc_bandHistory
        if sc_band.sourceKey != sc_lastSource
            for sc_bx in sc_band.sc_layers
                box.set_bgcolor(sc_bx, na)
                box.set_border_color(sc_bx, na)
    for sc_sc in sc_scArchive
        if sc_sc.sc_opened != sc_lastSource
            if not na(sc_sc.sc_tag)
                label.set_text(sc_sc.sc_tag, "")
                label.set_color(sc_sc.sc_tag, na)
                label.set_textcolor(sc_sc.sc_tag, na)
            if not na(sc_sc.sc_leader)
                line.set_color(sc_sc.sc_leader, na)
    for sc_marker in sc_labels
        if label.get_x(sc_marker) < sc_lastSource
            label.set_color(sc_marker, na)
            label.set_textcolor(sc_marker, na)

// Independent five-minute source stream. Never consume an unfinished candle.
sc_rbFive() =>
    int sc_k = sc_boundary == "Exchange trading day" ? time_tradingday : sc_customKey(time)
    int sc_localMinute = hour(time, "Asia/Kolkata")*60 + minute(time, "Asia/Kolkata")
    bool sc_first = sc_selected == "NSE/BSE" ? session.isfirstbar_regular : not na(sc_k[1]) and sc_k != sc_k[1]
    int sc_ended = sc_selected == "NSE/BSE" or sc_boundary == "Exchange trading day" ? time_close("1D") : timestamp(sc_zone, year(sc_k, sc_zone), month(sc_k, sc_zone), dayofmonth(sc_k, sc_zone)+1, sc_resetHour, sc_resetMinute)
    [open, high, low, close, time, time_close, sc_k, sc_ended, sc_first]
sc_rbFivePrevious() =>
    [sc_o, sc_hi, sc_lo, sc_c, sc_t, sc_ended, sc_k, sc_sessionEnd, sc_first] = sc_rbFive()
    [sc_o[1], sc_hi[1], sc_lo[1], sc_c[1], sc_t[1], sc_ended[1], sc_k[1], sc_sessionEnd[1], sc_first[1]]
type sc_CandleRangeSet
    int sc_dayKey
    string sc_kind
    int sc_started
    int sc_published
    float sc_o
    float sc_hi
    float sc_lo
    float sc_c
    array<line> sc_levels
    box sc_upper
    box sc_lower
    label sc_tag
var array<sc_CandleRangeSet> sc_rbSets = array.new<sc_CandleRangeSet>()
var array<int> sc_rbDays = array.new<int>()
type sc_CandleRangeState
    int sc_key
    int sc_lastT
    bool sc_xDone
    bool sc_redDone
    int sc_middayCount
    int sc_middayLast
    float sc_middayO
    float sc_middayH
    float sc_middayL
    int sc_eveningCount
    int sc_eveningLast
    float sc_eveningO
    float sc_eveningH
    float sc_eveningL
var sc_CandleRangeState sc_rbState = sc_CandleRangeState.new(na, na, false, false, 0, na, na, na, na, 0, na, na, na, na)
sc_rbDelete(sc_CandleRangeSet sc_item) =>
    for sc_ln in sc_item.sc_levels
        line.delete(sc_ln)
    box.delete(sc_item.sc_upper)
    box.delete(sc_item.sc_lower)
    label.delete(sc_item.sc_tag)
sc_rbDraw(string sc_kind, float sc_o, float sc_hi, float sc_lo, float sc_c, int sc_started, int sc_published, int sc_dayKey, int sc_sessionEnd) =>
    float sc_middle = sc_lo + (sc_hi-sc_lo)*sc_p2/100
    int sc_right = math.max(sc_published+300000, sc_sessionEnd)
    color sc_tint = sc_kind == "X" ? color.rgb(79, 70, 229) : sc_kind == "R" ? sc_bearColor : sc_kind == "M" ? color.rgb(14, 116, 144) : color.rgb(37, 99, 235)
    color sc_boundaryTint = sc_kind == "X" ? sc_tint : sc_bearColor
    array<line> sc_levels = array.new<line>()
    array<float> sc_ratios = array.from(sc_p1, sc_p2, sc_p3)
    array<color> sc_tints = array.from(sc_c1, sc_c2, sc_c3)
    for sc_i = 0 to 2
        float sc_price = sc_lo+(sc_hi-sc_lo)*array.get(sc_ratios, sc_i)/100
        array.push(sc_levels, line.new(sc_published, sc_price, sc_right, sc_price, xloc=xloc.bar_time, color=sc_boundaryTint, style=line.style_solid, width=2))
    box sc_upper = box.new(sc_published, sc_hi, sc_right, sc_middle, xloc=xloc.bar_time, border_color=sc_boundaryTint, border_width=2, border_style=line.style_solid, bgcolor=color.new(sc_boundaryTint, 91))
    box sc_lower = box.new(sc_published, sc_middle, sc_right, sc_lo, xloc=xloc.bar_time, border_color=sc_boundaryTint, border_width=2, border_style=line.style_solid, bgcolor=color.new(sc_boundaryTint, 95))
    string sc_title = sc_kind == "X" ? "First completed 5m candle" : sc_kind == "R" ? "First red 5m candle after X" : sc_kind == "M" ? "Six-candle midday blend (all colors)" : "Six-candle evening blend (17:30–18:00 India time)"
    string sc_detail = sc_title + "\nSource " + str.format_time(sc_started, "dd MMM HH:mm", "Asia/Kolkata") + "–" + str.format_time(sc_published, "HH:mm", "Asia/Kolkata") + "\nPublished only after source completion\nO " + str.tostring(sc_o, "#.##") + " · H " + str.tostring(sc_hi, "#.##") + " · L " + str.tostring(sc_lo, "#.##") + " · C " + str.tostring(sc_c, "#.##") + "\n" + str.tostring(sc_p1) + "% " + str.tostring(sc_lo+(sc_hi-sc_lo)*sc_p1/100, "#.##") + " · " + str.tostring(sc_p2) + "% " + str.tostring(sc_middle, "#.##") + " · " + str.tostring(sc_p3) + "% " + str.tostring(sc_lo+(sc_hi-sc_lo)*sc_p3/100, "#.##") + "\n5m range history: " + str.tostring(sc_rbKeep) + " sessions (drawing budget); SC history remains separate."
    label sc_tag = sc_showRangeLabels ? label.new(sc_published, sc_hi, sc_kind, xloc=xloc.bar_time, style=label.style_label_down, color=sc_tint, textcolor=color.white, size=size.tiny, tooltip=sc_detail) : na
    array.push(sc_rbSets, sc_CandleRangeSet.new(sc_dayKey, sc_kind, sc_started, sc_published, sc_o, sc_hi, sc_lo, sc_c, sc_levels, sc_upper, sc_lower, sc_tag))
sc_rbConsume(sc_CandleRangeState sc_state, float sc_o, float sc_hi, float sc_lo, float sc_c, int sc_t, int sc_ended, int sc_k, int sc_sessionEnd, bool sc_first) =>
    int sc_localMinute = hour(sc_t, "Asia/Kolkata")*60 + minute(sc_t, "Asia/Kolkata")
    bool sc_eligible = sc_selected != "NSE/BSE" or (sc_first or (sc_state.sc_xDone and sc_state.sc_key == sc_k and sc_t < sc_sessionEnd))
    if not na(sc_t) and (na(sc_state.sc_lastT) or sc_t > sc_state.sc_lastT) and sc_ended <= timenow
        if na(sc_state.sc_key) or sc_k != sc_state.sc_key
            sc_state.sc_key := sc_k
            sc_state.sc_xDone := false
            sc_state.sc_redDone := false
            sc_state.sc_middayCount := 0
            sc_state.sc_middayLast := na
            sc_state.sc_eveningCount := 0
            sc_state.sc_eveningLast := na
            array.push(sc_rbDays, sc_k)
            while array.size(sc_rbDays) > sc_rbKeep
                int sc_expired = array.shift(sc_rbDays)
                while array.size(sc_rbSets) > 0
                    sc_CandleRangeSet sc_oldest = array.get(sc_rbSets, 0)
                    if sc_oldest.sc_dayKey == sc_expired
                        sc_rbDelete(array.shift(sc_rbSets))
                    else
                        break
        if sc_first and not sc_state.sc_xDone
            sc_rbDraw("X", sc_o, sc_hi, sc_lo, sc_c, sc_t, sc_ended, sc_k, sc_sessionEnd)
            sc_state.sc_xDone := true
        else if sc_eligible and sc_state.sc_xDone and not sc_state.sc_redDone and sc_c < sc_o
            sc_rbDraw("R", sc_o, sc_hi, sc_lo, sc_c, sc_t, sc_ended, sc_k, sc_sessionEnd)
            sc_state.sc_redDone := true
        int sc_minutes = hour(sc_t, "Asia/Kolkata")*60 + minute(sc_t, "Asia/Kolkata")
        if sc_minutes >= 750 and sc_minutes < 780 and sc_ended-sc_t == 300000
            if sc_minutes == 750
                sc_state.sc_middayCount := 1
                sc_state.sc_middayO := sc_o
                sc_state.sc_middayH := sc_hi
                sc_state.sc_middayL := sc_lo
                sc_state.sc_middayLast := sc_t
            else if sc_state.sc_middayCount > 0 and sc_t-sc_state.sc_middayLast == 300000
                sc_state.sc_middayCount += 1
                sc_state.sc_middayH := math.max(sc_state.sc_middayH, sc_hi)
                sc_state.sc_middayL := math.min(sc_state.sc_middayL, sc_lo)
                sc_state.sc_middayLast := sc_t
            else
                sc_state.sc_middayCount := 0
            if sc_minutes == 775 and sc_state.sc_middayCount == 6
                sc_rbDraw("M", sc_state.sc_middayO, sc_state.sc_middayH, sc_state.sc_middayL, sc_c, sc_t-1500000, sc_ended, sc_k, sc_sessionEnd)
        int sc_indiaMinute = hour(sc_t, "Asia/Kolkata")*60 + minute(sc_t, "Asia/Kolkata")
        if sc_selected != "NSE/BSE" and sc_indiaMinute >= 1050 and sc_indiaMinute < 1080 and sc_ended-sc_t == 300000
            if sc_indiaMinute == 1050
                sc_state.sc_eveningCount := 1
                sc_state.sc_eveningO := sc_o
                sc_state.sc_eveningH := sc_hi
                sc_state.sc_eveningL := sc_lo
                sc_state.sc_eveningLast := sc_t
            else if sc_state.sc_eveningCount > 0 and sc_t-sc_state.sc_eveningLast == 300000
                sc_state.sc_eveningCount += 1
                sc_state.sc_eveningH := math.max(sc_state.sc_eveningH, sc_hi)
                sc_state.sc_eveningL := math.min(sc_state.sc_eveningL, sc_lo)
                sc_state.sc_eveningLast := sc_t
            else
                sc_state.sc_eveningCount := 0
            if sc_indiaMinute == 1075 and sc_state.sc_eveningCount == 6
                sc_rbDraw("E", sc_state.sc_eveningO, sc_state.sc_eveningH, sc_state.sc_eveningL, sc_c, sc_t-1500000, sc_ended, sc_k, sc_sessionEnd)
        sc_state.sc_lastT := sc_t
    sc_state.sc_lastT
// Higher charts receive EVERY 5m intrabar, not the last sampled one only.
[sc_rbO, sc_rbH, sc_rbL, sc_rbC, sc_rbT, sc_rbEnd, sc_rbKey, sc_rbSessionEnd, sc_rbFirst] = request.security_lower_tf(sc_requestTicker, "5", sc_rbFive(), ignore_invalid_timeframe=true)
[sc_rbPrevO, sc_rbPrevH, sc_rbPrevL, sc_rbPrevC, sc_rbPrevT, sc_rbPrevEnd, sc_rbPrevKey, sc_rbPrevSessionEnd, sc_rbPrevFirst] = request.security(sc_requestTicker, "5", sc_rbFivePrevious(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
[sc_rbCurrO, sc_rbCurrH, sc_rbCurrL, sc_rbCurrC, sc_rbCurrT, sc_rbCurrEnd, sc_rbCurrKey, sc_rbCurrSessionEnd, sc_rbCurrFirst] = request.security(sc_requestTicker, "5", sc_rbFive(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
if sc_enableRedBars
    if timeframe.in_seconds() >= 300
        if array.size(sc_rbT) > 0
            for sc_i = 0 to array.size(sc_rbT)-1
                if array.get(sc_rbEnd, sc_i) <= timenow and (not barstate.isrealtime or array.get(sc_rbEnd, sc_i) <= timenow)
                    sc_rbConsume(sc_rbState, array.get(sc_rbO, sc_i), array.get(sc_rbH, sc_i), array.get(sc_rbL, sc_i), array.get(sc_rbC, sc_i), array.get(sc_rbT, sc_i), array.get(sc_rbEnd, sc_i), array.get(sc_rbKey, sc_i), array.get(sc_rbSessionEnd, sc_i), array.get(sc_rbFirst, sc_i))
    else
        // Previous confirmed source is safe on 1m/2m/3m, including nondividing intervals.
        sc_rbConsume(sc_rbState, sc_rbPrevO, sc_rbPrevH, sc_rbPrevL, sc_rbPrevC, sc_rbPrevT, sc_rbPrevEnd, sc_rbPrevKey, sc_rbPrevSessionEnd, sc_rbPrevFirst)
        // Capture a just-closed 5m source even when its close falls inside a 2m/3m
        // chart candle or is the final session candle. Timestamp guards exclude
        // developing source prices; rbConsume deduplicates both source streams.
        if not na(sc_rbCurrEnd) and sc_rbCurrEnd <= time_close and sc_rbCurrEnd <= timenow
            sc_rbConsume(sc_rbState, sc_rbCurrO, sc_rbCurrH, sc_rbCurrL, sc_rbCurrC, sc_rbCurrT, sc_rbCurrEnd, sc_rbCurrKey, sc_rbCurrSessionEnd, sc_rbCurrFirst)

// SC confirmation uses the same native 5m feed, independently of red-bar visibility.
var int sc_scLastFiveEnd = na
if timeframe.in_seconds() >= 300
    if array.size(sc_rbEnd) > 0
        for sc_i = 0 to array.size(sc_rbEnd)-1
            int sc_ended = array.get(sc_rbEnd, sc_i)
            if not na(sc_ended) and sc_ended <= timenow and (na(sc_scLastFiveEnd) or sc_ended > sc_scLastFiveEnd)
                sc_activeSc := sc_scAdvance(sc_activeSc, array.get(sc_rbC, sc_i), sc_ended)
                sc_scLastFiveEnd := sc_ended
else
    if not na(sc_rbPrevEnd) and sc_rbPrevEnd <= time_close and sc_rbPrevEnd <= timenow and (na(sc_scLastFiveEnd) or sc_rbPrevEnd > sc_scLastFiveEnd)
        sc_activeSc := sc_scAdvance(sc_activeSc, sc_rbPrevC, sc_rbPrevEnd)
        sc_scLastFiveEnd := sc_rbPrevEnd
    if not na(sc_rbCurrEnd) and sc_rbCurrEnd <= time_close and sc_rbCurrEnd <= timenow and (na(sc_scLastFiveEnd) or sc_rbCurrEnd > sc_scLastFiveEnd)
        sc_activeSc := sc_scAdvance(sc_activeSc, sc_rbCurrC, sc_rbCurrEnd)
        sc_scLastFiveEnd := sc_rbCurrEnd
if not na(sc_activeSc)
    sc_rangeTag := sc_activeSc.sc_tag
    sc_tagLeader := sc_activeSc.sc_leader

// Latest completed oscillator readings, independent of chart timeframe.
sc_rsiOscValues() =>
    float sc_oscillator = ta.rsi(close, sc_rsiLength)
    float sc_average = ta.sma(sc_oscillator, sc_rsiSmaLength)
    [sc_oscillator, sc_average, sc_average[1], time_close]
sc_rsiOscPrevious() =>
    [sc_oscillator, sc_average, sc_priorAverage, sc_ended] = sc_rsiOscValues()
    [sc_oscillator[1], sc_average[1], sc_priorAverage[1], sc_ended[1]]
[sc_osc5Prev, sc_avg5Prev, sc_avg5PriorPrev, sc_osc5PrevEnd] = request.security(sc_requestTicker, "5", sc_rsiOscPrevious(), gaps=barmerge.gaps_off, lookahead=timeframe.in_seconds() > 300 ? barmerge.lookahead_off : barmerge.lookahead_on)
[sc_osc15Prev, sc_avg15Prev, sc_avg15PriorPrev, sc_osc15PrevEnd] = request.security(sc_requestTicker, "15", sc_rsiOscPrevious(), gaps=barmerge.gaps_off, lookahead=timeframe.in_seconds() > 900 ? barmerge.lookahead_off : barmerge.lookahead_on)
[sc_osc30Prev, sc_avg30Prev, sc_avg30PriorPrev, sc_osc30PrevEnd] = request.security(sc_requestTicker, "30", sc_rsiOscPrevious(), gaps=barmerge.gaps_off, lookahead=timeframe.in_seconds() > 1800 ? barmerge.lookahead_off : barmerge.lookahead_on)
[sc_osc5Current, sc_avg5Current, sc_avg5PriorCurrent, sc_osc5CurrentEnd] = request.security(sc_requestTicker, "5", sc_rsiOscValues(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[sc_osc15Current, sc_avg15Current, sc_avg15PriorCurrent, sc_osc15CurrentEnd] = request.security(sc_requestTicker, "15", sc_rsiOscValues(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
[sc_osc30Current, sc_avg30Current, sc_avg30PriorCurrent, sc_osc30CurrentEnd] = request.security(sc_requestTicker, "30", sc_rsiOscValues(), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)
sc_closedOsc(float sc_previousRsi, float sc_previousAverage, float sc_previousPriorAverage, int sc_previousEnd, float sc_currentRsi, float sc_currentAverage, float sc_currentPriorAverage, int sc_currentEnd) =>
    bool sc_completed = not na(sc_currentEnd) and sc_currentEnd <= timenow and sc_currentEnd <= time_close
    [sc_completed ? sc_currentRsi : sc_previousRsi, sc_completed ? sc_currentAverage : sc_previousAverage, sc_completed ? sc_currentPriorAverage : sc_previousPriorAverage, sc_completed ? sc_currentEnd : sc_previousEnd]
[sc_tableOsc5, sc_tableAvg5, sc_tablePriorAvg5, sc_tableEnd5] = sc_closedOsc(sc_osc5Prev, sc_avg5Prev, sc_avg5PriorPrev, sc_osc5PrevEnd, sc_osc5Current, sc_avg5Current, sc_avg5PriorCurrent, sc_osc5CurrentEnd)
[sc_tableOsc15, sc_tableAvg15, sc_tablePriorAvg15, sc_tableEnd15] = sc_closedOsc(sc_osc15Prev, sc_avg15Prev, sc_avg15PriorPrev, sc_osc15PrevEnd, sc_osc15Current, sc_avg15Current, sc_avg15PriorCurrent, sc_osc15CurrentEnd)
[sc_tableOsc30, sc_tableAvg30, sc_tablePriorAvg30, sc_tableEnd30] = sc_closedOsc(sc_osc30Prev, sc_avg30Prev, sc_avg30PriorPrev, sc_osc30PrevEnd, sc_osc30Current, sc_avg30Current, sc_avg30PriorCurrent, sc_osc30CurrentEnd)

// Latest locked SC is pinned; revealed targets belong ONLY to this chain.
sc_scTableRow(table sc_target, int sc_row, int sc_opened, int sc_ended, float sc_hi, float sc_lo, string sc_caption, color sc_tint, string sc_identity) =>
    bool sc_available = not na(sc_hi) and not na(sc_lo)
    string sc_detail = sc_identity + (not na(sc_opened) ? "\nSource " + str.format_time(sc_opened, "dd MMM yyyy HH:mm", "Asia/Kolkata") + "–" + str.format_time(sc_ended, "HH:mm", "Asia/Kolkata") + " IST" : "") + (sc_available ? "\nH " + str.tostring(sc_hi, "#,###.00") + " · L " + str.tostring(sc_lo, "#,###.00") : "\nSource unavailable") + "\nState uses current price against full high/low; equality is In range."
    table.cell(sc_target, 0, sc_row, sc_caption, text_color=color.white, bgcolor=sc_tint, text_size=size.tiny, tooltip=sc_detail)
    array<float> sc_ratios = array.from(sc_p1, sc_p2, sc_p3)
    for sc_col = 0 to 2
        table.cell(sc_target, sc_col+1, sc_row, sc_available ? str.tostring(sc_lo+(sc_hi-sc_lo)*array.get(sc_ratios, sc_col)/100, "#,###.##") : "—", text_color=color.rgb(30,41,59), bgcolor=color.white, text_size=size.tiny, tooltip=sc_detail)
    string sc_state = not sc_available or na(close) ? "—" : close > sc_hi ? "Bullish" : close < sc_lo ? "Bearish" : "In range"
    color sc_stateColor = not sc_available or na(close) ? color.gray : close > sc_hi ? sc_bullColor : close < sc_lo ? sc_bearColor : color.rgb(180,120,10)
    table.cell(sc_target, 4, sc_row, sc_state, text_color=sc_stateColor, bgcolor=color.white, text_size=size.tiny, tooltip=sc_detail)
var table sc_rbPanel = na
if barstate.islast and not sc_showPanel and not na(sc_rbPanel)
    table.delete(sc_rbPanel)
    sc_rbPanel := na
if barstate.islast and sc_showPanel
    array<sc_SCReference> sc_chainTargets = array.new<sc_SCReference>()
    array<int> sc_revealTimes = array.new<int>()
    for sc_item in sc_scArchive
        if not na(sc_scChainKey) and not na(sc_item.sc_visitedChain) and sc_item.sc_visitedChain == sc_scChainKey and sc_item.sc_opened != sc_lastSource and sc_item.sc_approach != 0 and not na(sc_item.sc_anchorAt)
            array.push(sc_chainTargets, sc_item)
            array.push(sc_revealTimes, sc_item.sc_anchorAt)
    array<int> sc_targetOrder = array.sort_indices(sc_revealTimes, order.ascending)
    int sc_targetCount = array.size(sc_chainTargets)
    int sc_pageCount = math.max(1, int(math.ceil(sc_targetCount/2.0)))
    int sc_targetPage = math.min(sc_scTargetPage, sc_pageCount)
    int sc_firstTarget = (sc_targetPage-1)*2
    int sc_visibleTargets = math.max(0, math.min(2, sc_targetCount-sc_firstTarget))
    bool sc_pagedTargets = sc_targetCount > 2
    int sc_xStart = 2 + sc_visibleTargets + (sc_pagedTargets ? 1 : 0)
    int sc_latestRedRow = sc_xStart+4
    int sc_rsiHeader = sc_xStart+5
    int sc_prevHeader = sc_rsiHeader+3
    int sc_footerRow = sc_prevHeader+4
    if not na(sc_rbPanel)
        table.delete(sc_rbPanel)
    sc_rbPanel := table.new(showDashboard and dashboardMode != "Off" and dashboardAnchor == position.middle_right ? position.middle_left : position.middle_right, 5, sc_footerRow+1, border_width=1, border_color=color.new(color.gray,55), frame_width=1, frame_color=color.new(color.gray,55))
    table.merge_cells(sc_rbPanel, 0, sc_footerRow, 4, sc_footerRow)
    for sc_row = sc_rsiHeader to sc_rsiHeader+2
        table.merge_cells(sc_rbPanel, 0, sc_row, 1, sc_row)
    table.cell(sc_rbPanel, 0, 0, "Levels · IST", text_color=color.white, bgcolor=color.rgb(30,41,59), text_size=size.tiny)
    array<float> sc_ratios = array.from(sc_p1, sc_p2, sc_p3)
    for sc_col = 0 to 2
        table.cell(sc_rbPanel, sc_col+1, 0, str.tostring(array.get(sc_ratios,sc_col), "#.##")+"%", text_color=color.white, bgcolor=color.rgb(30,41,59), text_size=size.tiny)
    table.cell(sc_rbPanel, 4, 0, "State", text_color=color.white, bgcolor=color.rgb(30,41,59), text_size=size.tiny, tooltip="Live price compared with full source high/low, not the three Fib levels.")
    sc_scTableRow(sc_rbPanel, 1, sc_lastSource, sc_lockedClose, not sc_missingFinal ? sc_lockedHigh : na, not sc_missingFinal ? sc_lockedLow : na, "SC" + (not na(sc_lastSource) ? " " + str.format_time(sc_lastSource,"dd MMM","Asia/Kolkata") : " · —"), color.rgb(30,41,59), "Latest completed Shadow Candle; matches the locked latest-SC panel.")
    if sc_visibleTargets > 0
        for sc_i = 0 to sc_visibleTargets-1
            sc_SCReference sc_item = array.get(sc_chainTargets, array.get(sc_targetOrder, sc_firstTarget+sc_i))
            sc_scTableRow(sc_rbPanel, 2+sc_i, sc_item.sc_opened, sc_item.sc_closed, sc_item.sc_hi, sc_item.sc_lo, "→SC " + str.format_time(sc_item.sc_opened,"dd MMM","Asia/Kolkata"), sc_item.sc_approach > 0 ? sc_bullColor : sc_bearColor, "Historical SC revealed in the current breakout chain. Original SC remains pinned above. Revealed " + str.format_time(sc_item.sc_anchorAt,"dd MMM HH:mm","Asia/Kolkata")+" IST.")
    if sc_pagedTargets
        int sc_pageRow = 2+sc_visibleTargets
        table.merge_cells(sc_rbPanel, 0, sc_pageRow, 4, sc_pageRow)
        table.cell(sc_rbPanel, 0, sc_pageRow, "SC targets " + str.tostring(sc_firstTarget+1)+"–"+str.tostring(sc_firstTarget+sc_visibleTargets)+"/"+str.tostring(sc_targetCount)+" · page "+str.tostring(sc_targetPage)+"/"+str.tostring(sc_pageCount), text_color=color.gray, bgcolor=color.white, text_size=size.tiny, tooltip="Use Inputs → SC target table page to view every revealed target. Latest base SC stays pinned on each page. Two targets per page keep the table readable.")
    array<string> sc_names = array.from("X","R","M","E")
    for sc_row = 0 to 3
        string sc_kind = array.get(sc_names,sc_row)
        sc_CandleRangeSet sc_found = na
        for sc_item in sc_rbSets
            if sc_item.sc_dayKey == sc_rbState.sc_key and sc_item.sc_kind == sc_kind
                sc_found := sc_item
        color sc_tint = sc_kind == "X" ? color.rgb(79,70,229) : sc_kind == "R" ? sc_bearColor : sc_kind == "M" ? color.rgb(14,116,144) : color.rgb(37,99,235)
        string sc_caption = sc_kind + (not na(sc_found) ? " " + str.format_time(sc_found.sc_started,"HH:mm","Asia/Kolkata")+"–"+str.format_time(sc_found.sc_published,"HH:mm","Asia/Kolkata") : " · —")
        string sc_detail = not na(sc_found) ? "Source " + str.format_time(sc_found.sc_started,"dd MMM yyyy HH:mm","Asia/Kolkata")+"–"+str.format_time(sc_found.sc_published,"HH:mm","Asia/Kolkata")+" IST\nO "+str.tostring(sc_found.sc_o,"#.##")+" · H "+str.tostring(sc_found.sc_hi,"#.##")+" · L "+str.tostring(sc_found.sc_lo,"#.##")+" · C "+str.tostring(sc_found.sc_c,"#.##") : "No completed set. X: first regular opening 5m; R: next red; M: six candles 12:30–13:00 IST everywhere; E: six candles 17:30–18:00 IST except NSE/BSE. Incomplete windows are unavailable."
        table.cell(sc_rbPanel,0,sc_xStart+sc_row,sc_caption,text_color=color.white,bgcolor=sc_tint,text_size=size.tiny,tooltip=sc_detail)
        for sc_col = 0 to 2
            table.cell(sc_rbPanel,sc_col+1,sc_xStart+sc_row,not na(sc_found) ? str.tostring(sc_found.sc_lo+(sc_found.sc_hi-sc_found.sc_lo)*array.get(sc_ratios,sc_col)/100,"#,###.##") : "—",text_color=sc_tint,bgcolor=color.white,text_size=size.tiny,tooltip=sc_detail)
        string sc_state = na(sc_found) or na(close) ? "—" : close > sc_found.sc_hi ? "Bullish" : close < sc_found.sc_lo ? "Bearish" : "In range"
        color sc_stateColor = na(sc_found) or na(close) ? color.gray : close > sc_found.sc_hi ? sc_bullColor : close < sc_found.sc_lo ? sc_bearColor : color.rgb(180,120,10)
        table.cell(sc_rbPanel,4,sc_xStart+sc_row,sc_state,text_color=sc_stateColor,bgcolor=color.white,text_size=size.tiny,tooltip=sc_detail+"\nCurrent price "+str.tostring(close,"#,###.00")+"; State uses full source high/low, inclusive boundaries In range.")
    sc_CandleRangeSet sc_latestRed = na
    if sc_enableRedBars
        for sc_candidate in sc_rbSets
            if sc_candidate.sc_kind != "X" and sc_candidate.sc_published <= timenow and sc_candidate.sc_published <= time_close
                if na(sc_latestRed) or sc_candidate.sc_published > sc_latestRed.sc_published or (sc_candidate.sc_published == sc_latestRed.sc_published and sc_candidate.sc_kind != "R")
                    sc_latestRed := sc_candidate
    string sc_latestState = na(sc_latestRed) or na(close) ? "—" : close > sc_latestRed.sc_hi ? "Bullish" : close < sc_latestRed.sc_lo ? "Bearish" : "In range"
    color sc_latestColor = na(sc_latestRed) or na(close) ? color.gray : close > sc_latestRed.sc_hi ? sc_bullColor : close < sc_latestRed.sc_lo ? sc_bearColor : color.rgb(180,120,10)
    string sc_latestCaption = na(sc_latestRed) ? "Unavailable" : sc_latestRed.sc_kind+" "+str.format_time(sc_latestRed.sc_started,"dd MMM HH:mm","Asia/Kolkata")+"–"+str.format_time(sc_latestRed.sc_published,"HH:mm","Asia/Kolkata")
    string sc_latestDetail = "Decision uses the newest completed R/M/E range by publication time; X is excluded. Earlier rows describe their own source ranges."
    if not na(sc_latestRed)
        sc_latestDetail += "\n"+sc_latestCaption+" IST\nHigh "+str.tostring(sc_latestRed.sc_hi,"#,###.00")+" · Low "+str.tostring(sc_latestRed.sc_lo,"#,###.00")+"\nCurrent price "+str.tostring(close,"#,###.00")+"; above high Bullish, below low Bearish, inclusive boundaries In range."
    table.merge_cells(sc_rbPanel,1,sc_latestRedRow,3,sc_latestRedRow)
    table.cell(sc_rbPanel,0,sc_latestRedRow,"Latest red",text_color=color.white,bgcolor=color.rgb(153,27,27),text_size=size.tiny,tooltip=sc_latestDetail)
    table.cell(sc_rbPanel,1,sc_latestRedRow,sc_latestCaption,text_color=color.rgb(30,41,59),bgcolor=color.rgb(254,242,242),text_size=size.tiny,tooltip=sc_latestDetail)
    table.cell(sc_rbPanel,4,sc_latestRedRow,sc_latestState,text_color=sc_latestColor,bgcolor=color.white,text_size=size.tiny,tooltip=sc_latestDetail)
    table.cell(sc_rbPanel,0,sc_rsiHeader,"RSI · closed",text_color=color.white,bgcolor=color.rgb(30,41,59),text_size=size.tiny,tooltip="RSI oscillator values 0–100 on each latest completed native candle; separate from the price-threshold overlay.")
    array<string> sc_oscFrames = array.from("5m","15m","30m")
    array<float> sc_oscReadings = array.from(sc_tableOsc5,sc_tableOsc15,sc_tableOsc30)
    array<float> sc_oscAverages = array.from(sc_tableAvg5,sc_tableAvg15,sc_tableAvg30)
    array<float> sc_oscPriorAverages = array.from(sc_tablePriorAvg5,sc_tablePriorAvg15,sc_tablePriorAvg30)
    array<int> sc_oscEnds = array.from(sc_tableEnd5,sc_tableEnd15,sc_tableEnd30)
    table.cell(sc_rbPanel,0,sc_rsiHeader+1,"RSI",text_color=color.white,bgcolor=color.rgb(30,41,59),text_size=size.tiny)
    table.cell(sc_rbPanel,0,sc_rsiHeader+2,"RSI SMA",text_color=color.white,bgcolor=color.rgb(30,41,59),text_size=size.tiny)
    for sc_col = 0 to 2
        float sc_reading = array.get(sc_oscReadings,sc_col)
        float sc_average = array.get(sc_oscAverages,sc_col)
        float sc_priorAverage = array.get(sc_oscPriorAverages,sc_col)
        bool sc_slopeAvailable = not na(sc_average) and not na(sc_priorAverage)
        int sc_direction = sc_slopeAvailable ? (sc_average > sc_priorAverage ? 1 : sc_average < sc_priorAverage ? -1 : 0) : 0
        color sc_slopeColor = not sc_enableRsiOverlay or not sc_slopeAvailable or sc_direction == 0 ? color.gray : sc_direction > 0 ? sc_bullColor : sc_bearColor
        string sc_rsiValue = not sc_enableRsiOverlay ? "Off" : not na(sc_reading) ? str.tostring(sc_reading,"0.00") : "—"
        string sc_smaValue = not sc_enableRsiOverlay ? "Off" : not na(sc_average) ? str.tostring(sc_average,"0.00")+(sc_slopeAvailable ? (sc_direction > 0 ? " ↑" : sc_direction < 0 ? " ↓" : " →") : "") : "—"
        string sc_detail = "RSI "+str.tostring(sc_rsiLength)+" / SMA "+str.tostring(sc_rsiSmaLength)+" · "+array.get(sc_oscFrames,sc_col)+"\nLatest completed candle ends "+(not na(array.get(sc_oscEnds,sc_col)) ? str.format_time(array.get(sc_oscEnds,sc_col),"dd MMM HH:mm","Asia/Kolkata")+" IST" : "unavailable")+"\nArrow compares completed RSI SMA with its previous completed value, not RSI direction. The table RSI visibility control governs these readings."
        table.cell(sc_rbPanel,sc_col+2,sc_rsiHeader,array.get(sc_oscFrames,sc_col),text_color=color.white,bgcolor=color.rgb(30,41,59),text_size=size.tiny)
        table.cell(sc_rbPanel,sc_col+2,sc_rsiHeader+1,sc_rsiValue,text_color=sc_enableRsiOverlay ? color.rgb(30,41,59) : color.gray,bgcolor=color.white,text_size=size.tiny,tooltip=sc_detail)
        table.cell(sc_rbPanel,sc_col+2,sc_rsiHeader+2,sc_smaValue,text_color=sc_slopeColor,bgcolor=color.white,text_size=size.tiny,tooltip=sc_detail)
    for sc_row = sc_prevHeader to sc_prevHeader+3
        table.merge_cells(sc_rbPanel,1,sc_row,2,sc_row)
        table.merge_cells(sc_rbPanel,3,sc_row,4,sc_row)
    table.cell(sc_rbPanel,0,sc_prevHeader,"Period",text_color=color.white,bgcolor=color.rgb(30,41,59),text_size=size.small,tooltip="Previous completed day, week and month only; never the forming period.")
    table.cell(sc_rbPanel,1,sc_prevHeader,"High",text_color=color.white,bgcolor=color.rgb(30,41,59),text_size=size.small)
    table.cell(sc_rbPanel,3,sc_prevHeader,"Low",text_color=color.white,bgcolor=color.rgb(30,41,59),text_size=size.small)
    array<string> sc_prevNames = array.from("Prev day","Prev week","Prev month")
    array<float> sc_prevHighs = array.from(sc_pdh,sc_pwh,sc_pmh)
    array<float> sc_prevLows = array.from(sc_pdl,sc_pwl,sc_pml)
    array<int> sc_prevSources = array.from(sc_daySource,sc_weekSource,sc_monthSource)
    for sc_row = 0 to 2
        string sc_detail = array.get(sc_prevNames,sc_row)+" · completed source "+(not na(array.get(sc_prevSources,sc_row)) ? str.format_time(array.get(sc_prevSources,sc_row),"dd MMM yyyy","Asia/Kolkata") : "unavailable")+". Independent of chart-line visibility. Missing values show —."
        table.cell(sc_rbPanel,0,sc_prevHeader+1+sc_row,array.get(sc_prevNames,sc_row),text_color=color.white,bgcolor=color.rgb(30,41,59),text_size=size.small,tooltip=sc_detail)
        table.cell(sc_rbPanel,1,sc_prevHeader+1+sc_row,not na(array.get(sc_prevHighs,sc_row)) ? str.tostring(array.get(sc_prevHighs,sc_row),"#,###.##") : "—",text_color=color.rgb(30,41,59),bgcolor=color.white,text_size=size.small,tooltip=sc_detail)
        table.cell(sc_rbPanel,3,sc_prevHeader+1+sc_row,not na(array.get(sc_prevLows,sc_row)) ? str.tostring(array.get(sc_prevLows,sc_row),"#,###.##") : "—",text_color=color.rgb(30,41,59),bgcolor=color.white,text_size=size.small,tooltip=sc_detail)
    table.cell(sc_rbPanel,0,sc_footerRow,"History: "+str.tostring(sc_rbKeep)+" · "+(sc_showRedHistory ? "shown" : "hidden"),text_color=color.gray,bgcolor=color.white,text_size=size.tiny)
    if not sc_showRedHistory
        for sc_item in sc_rbSets
            if sc_item.sc_dayKey != sc_rbState.sc_key
                for sc_ln in sc_item.sc_levels
                    line.set_color(sc_ln,na)
                box.set_bgcolor(sc_item.sc_upper,na)
                box.set_border_color(sc_item.sc_upper,na)
                box.set_bgcolor(sc_item.sc_lower,na)
                box.set_border_color(sc_item.sc_lower,na)
                if not na(sc_item.sc_tag)
                    label.set_text(sc_item.sc_tag, "")
                    label.set_color(sc_item.sc_tag, na)


// Black-box reconstruction, 2026-11-09: observed common confirmed 5m source on 2m/5m.
// Bounds and displacement perturbation are measured; private quality scoring is not recovered.
string rzGroup = "OB — Reconstructed synchronized zones"
bool rzEnabled = input.bool(true, "Show synchronized supply / demand", group=rzGroup, tooltip="Behavioral reconstruction from observed reference output. Three HCL source-candle boundaries and a displacement-filter perturbation matched; universal private-engine parity is not established.", display=display.none)
string rzSourceTf = input.timeframe("5", "Common confirmed source timeframe", group=rzGroup, display=display.none)
int rzStrength = input.int(5, "Confirmed swing strength", minval=1, maxval=20, group=rzGroup, display=display.none)
int rzSearch = input.int(12, "Opposing source candle search", minval=1, maxval=100, group=rzGroup, display=display.none)
int rzAtrLength = input.int(14, "Displacement ATR period", minval=2, group=rzGroup, display=display.none)
float rzBody = input.float(0.8, "Minimum displacement body / ATR", minval=0.1, step=0.1, group=rzGroup, display=display.none)
int rzSpacing = input.int(3, "Source candles between same-side zones", minval=0, maxval=100, group=rzGroup, display=display.none)
float rzNear = input.float(0.35, "Suppress nearby same-side zones (ATR)", minval=0, step=0.05, group=rzGroup, display=display.none)
int rzDays = input.int(15, "Zone history (calendar days)", minval=1, maxval=90, group=rzGroup, display=display.none)
int rzFresh = input.int(3, "Active zones per direction", minval=1, maxval=10, group=rzGroup, display=display.none)
bool rzEnded = input.bool(true, "Show ended zone history", group=rzGroup, display=display.none)
bool rzLabels = input.bool(false, "Show zone evidence labels", group=rzGroup, tooltip="Reference's synchronized rectangles were observed without text. Optional labels identify reconstructed side, source timeframe and lifecycle; they do not invent the private quality score.", display=display.none)
bool rzFreeze = input.bool(true, "Freeze after a source close re-enters", group=rzGroup, tooltip="Observed wick-only retests leave synchronized zones active. A completed source close inside the range freezes the historical rectangle; this is not confirmed support/resistance.", display=display.none)
color rzDemandColor = input.color(color.green, "Demand rectangle", group=rzGroup, display=display.none)
color rzSupplyColor = input.color(color.red, "Supply rectangle", group=rzGroup, display=display.none)
int rzFill = input.int(88, "Active rectangle transparency", minval=0, maxval=100, group=rzGroup, display=display.none)
int rzOldFill = input.int(93, "Ended rectangle transparency", minval=0, maxval=100, group=rzGroup, display=display.none)
float rzDistance = input.float(30, "Maximum visible distance (source ATR)", minval=1, maxval=100, group=rzGroup, display=display.none)
type RZRecord
    float hi
    float lo
    int origin
    int born
    int finish
    int side
    int state
    int tests
    bool touching
rzEngine() =>
    var array<RZRecord> records = array.new<RZRecord>()
    var float swingHigh = na
    var float swingLow = na
    var bool highBroken = false
    var bool lowBroken = false
    var int lastUp = na
    var int lastDown = na
    float atr = ta.atr(rzAtrLength)
    float ph = ta.pivothigh(high, rzStrength, rzStrength)
    float pl = ta.pivotlow(low, rzStrength, rzStrength)
    // Process [1] exclusively: every price, pivot confirmation and trigger is completed.
    // Source-origin geometry is retrospective; born retains the actual detection close.
    if not na(time[1]) and not na(atr[1])
        if array.size(records) > 0
            for i = array.size(records)-1 to 0
                RZRecord z = array.get(records,i)
                if time_close[1]-z.origin > rzDays*86400000
                    array.remove(records,i)
                else if z.state != 2 and (not rzFreeze or z.state == 0) and time_close[1] > z.born
                    bool invalid = z.side == 1 ? close[1] < z.lo : close[1] > z.hi
                    bool touched = close[1] >= z.lo and close[1] <= z.hi
                    if invalid
                        z.state := 2
                        if not rzFreeze or z.tests == 0
                            z.finish := time_close[1]
                        z.touching := false
                    else
                        if touched and not z.touching
                            z.tests += 1
                            z.state := 1
                            if rzFreeze and z.tests == 1
                                z.finish := time_close[1]
                        z.touching := touched
                        if not rzFreeze or z.tests == 0
                            z.finish := time_close[1]
        if not na(ph[1])
            swingHigh := ph[1]
            highBroken := false
        if not na(pl[1])
            swingLow := pl[1]
            lowBroken := false
        bool breakUp = not na(swingHigh) and not highBroken and close[1] > swingHigh
        bool breakDown = not na(swingLow) and not lowBroken and close[1] < swingLow
        // Observed weak first break consumes the swing, even if displacement fails.
        if breakUp
            highBroken := true
        if breakDown
            lowBroken := true
        int side = breakUp ? 1 : breakDown ? -1 : 0
        float body = math.abs(close[1]-open[1])/atr[1]
        int last = side == 1 ? lastUp : lastDown
        if side != 0 and body >= rzBody and (na(last) or bar_index-1-last >= rzSpacing)
            int offset = na
            for j = 2 to rzSearch+1
                bool opposing = side == 1 ? close[j] < open[j] : close[j] > open[j]
                if opposing and na(offset)
                    offset := j
            if not na(offset)
                float hi = high[offset]
                float lo = low[offset]
                bool duplicate = false
                for z in records
                    if z.side == side and (z.origin == time[offset] or (z.state == 0 and math.abs((z.hi+z.lo-hi-lo)/2) <= atr[1]*rzNear))
                        duplicate := true
                if not duplicate and hi > lo
                    array.push(records,RZRecord.new(hi,lo,time[offset],time_close[1],time_close[1],side,0,0,false))
                    if side == 1
                        lastUp := bar_index-1
                    else
                        lastDown := bar_index-1
        while array.size(records) > 180
            array.shift(records)
    // Return the collection only at the source's last bar: bounded cross-context memory.
    barstate.islast ? records : na
array<RZRecord> rzRecords = request.security(symbol,rzSourceTf,rzEngine(),gaps=barmerge.gaps_off,lookahead=barmerge.lookahead_off,calc_bars_count=10000)
float rzSourceAtr = request.security(symbol,rzSourceTf,ta.atr(rzAtrLength)[1],lookahead=barmerge.lookahead_on)
var array<box> rzBoxes = array.new<box>()
float rzSupplyHi = na
float rzSupplyLo = na
float rzDemandHi = na
float rzDemandLo = na
int rzActiveSupply = 0
int rzActiveDemand = 0
if barstate.islast
    for drawing in rzBoxes
        box.delete(drawing)
    array.clear(rzBoxes)
    if rzEnabled and chart.is_standard and not na(rzRecords) and array.size(rzRecords) > 0
        for i = array.size(rzRecords)-1 to 0
            RZRecord z = array.get(rzRecords,i)
            bool activeZone = z.state == 0
            int count = z.side == 1 ? rzActiveDemand : rzActiveSupply
            float distance = z.lo > close ? z.lo-close : z.hi < close ? close-z.hi : 0
            bool visibleZone = z.born <= time_close and (activeZone ? count < rzFresh : rzEnded) and distance <= rzSourceAtr*rzDistance
            if visibleZone and array.size(rzBoxes) < 90
                color tint = z.side == 1 ? rzDemandColor : rzSupplyColor
                int ended = activeZone and (not rzFreeze or z.tests == 0) ? time_close : z.finish
                string phase = z.state == 2 ? "INVALIDATED" : z.touching ? "RETESTING" : z.tests > 0 ? "RETESTED" : "FRESH"
                string caption = rzLabels ? (z.side == 1 ? "DEMAND" : "SUPPLY")+" · "+rzSourceTf+"m · "+phase+"\n"+str.tostring(z.lo,"#.##")+"–"+str.tostring(z.hi,"#.##") : ""
                array.push(rzBoxes,box.new(z.origin,z.hi,ended,z.lo,xloc=xloc.bar_time,border_color=color.new(tint,activeZone ? 30 : 75),bgcolor=color.new(tint,activeZone ? rzFill : z.state == 1 ? 85 : rzOldFill),text=caption,text_color=tint,text_size=size.tiny,text_halign=text.align_right,text_valign=z.side==1 ? text.align_bottom : text.align_top))
                if activeZone
                    if z.side == 1
                        rzActiveDemand += 1
                        if na(rzDemandHi) or math.abs(close-(z.hi+z.lo)/2) < math.abs(close-(rzDemandHi+rzDemandLo)/2)
                            rzDemandHi := z.hi
                            rzDemandLo := z.lo
                    else
                        rzActiveSupply += 1
                        if na(rzSupplyHi) or math.abs(close-(z.hi+z.lo)/2) < math.abs(close-(rzSupplyHi+rzSupplyLo)/2)
                            rzSupplyHi := z.hi
                            rzSupplyLo := z.lo
plot(rzSupplyHi,"Reconstructed nearest supply high",display=display.data_window)
plot(rzSupplyLo,"Reconstructed nearest supply low",display=display.data_window)
plot(rzDemandHi,"Reconstructed nearest demand high",display=display.data_window)
plot(rzDemandLo,"Reconstructed nearest demand low",display=display.data_window)

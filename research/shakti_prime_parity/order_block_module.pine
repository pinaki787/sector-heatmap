

// Inferred order blocks: confirmed swing break, displacement and last opposing candle.
string gOB="04 — ORDER BLOCKS"
bool obEnabled=input.bool(true,"Enable Order Block Detection",group=gOB,tooltip="Independent inferred detector. Confirmed swing break plus displacement identifies the last opposing candle; not verified Shakti Prime scoring.",display=display.none)
int obStrength=input.int(5,"Confirmed swing strength",minval=1,maxval=20,group=gOB,display=display.none)
int obSearch=input.int(12,"Find origin candle within bars",minval=1,maxval=100,group=gOB,display=display.none)
int obATRLength=input.int(14,"Displacement ATR period",minval=1,group=gOB,display=display.none)
float obBodyMinimum=input.float(0.8,"Minimum break candle body / ATR",minval=0.0,step=0.1,group=gOB,display=display.none)
bool obStrictSweep=input.bool(false,"Require prior liquidity sweep",group=gOB,display=display.none)
int obSweepWindow=input.int(20,"Sweep detection window",minval=2,maxval=200,group=gOB,display=display.none)
int obMinimumScore=input.int(65,"Minimum inferred quality score",minval=0,maxval=100,group=gOB,tooltip="Research score: 50 for confirmed structure break, up to 30 for displacement, 10 for a recent sweep, 10 for SMA alignment.",display=display.none)
int obMaxHistory=input.int(180,"Maximum historical zones",minval=1,maxval=180,group=gOB,display=display.none)
int obFreshLimit=input.int(3,"Maximum fresh blocks per direction",minval=1,maxval=10,group=gOB,display=display.none)
int obTouchedLimit=input.int(180,"Maximum historical touched blocks",minval=0,maxval=180,group=gOB,display=display.none)
float obNearATR=input.float(0.35,"Suppress nearby same-direction blocks (ATR)",minval=0.0,step=0.05,group=gOB,display=display.none)
int obSpacing=input.int(3,"Bars between same-direction blocks",minval=0,maxval=100,group=gOB,display=display.none)
bool obSMAFilter=input.bool(false,"Use SMA directional alignment",group=gOB,display=display.none)
int obKeepDays=input.int(15,"Keep historical zones (calendar days)",minval=1,maxval=365,group=gOB,display=display.none)
bool obFreeze=input.bool(true,"Freeze zone on first touch",group=gOB,display=display.none)
string obInvalidation=input.string("Close","Invalidate on",options=["Close","Wick"],group=gOB,display=display.none)
string obBoundary=input.string("Full candle","Zone boundary",options=["Full candle","Body to wick"],group=gOB,display=display.none)
bool obLabels=input.bool(true,"Show Supply / Demand labels",group=gOB,display=display.none)
bool obShowInvalid=input.bool(false,"Show invalidated zones",group=gOB,display=display.none)
bool obNearPrice=input.bool(true,"Limit visible zones to nearby price",group=gOB,display=display.none)
float obDistanceATR=input.float(20.0,"Maximum visible zone distance / ATR",minval=1.0,step=1.0,group=gOB,display=display.none)
color obDemandColor=input.color(color.rgb(0,180,90),"Demand zone",group=gOB,display=display.none)
color obSupplyColor=input.color(color.rgb(220,38,38),"Supply zone",group=gOB,display=display.none)
int obFreshTransparency=input.int(73,"Fresh fill transparency",minval=0,maxval=100,group=gOB,display=display.none)
int obTouchTransparency=input.int(85,"Touched fill transparency",minval=0,maxval=100,group=gOB,display=display.none)
int obInvalidTransparency=input.int(93,"Invalid fill transparency",minval=0,maxval=100,group=gOB,display=display.none)
bool obStrictSmall=input.bool(true,"Stricter filtering below 5m",group="05 — ORDER BLOCK NOISE CONTROL",display=display.none)
float obSmallBody=input.float(0.9,"Below 5m minimum body / ATR",minval=0.0,step=0.1,group="05 — ORDER BLOCK NOISE CONTROL",display=display.none)
int obSmallSpacing=input.int(8,"Below 5m bars between blocks",minval=0,maxval=100,group="05 — ORDER BLOCK NOISE CONTROL",display=display.none)
int obSmallFresh=input.int(2,"Below 5m fresh blocks per direction",minval=1,maxval=10,group="05 — ORDER BLOCK NOISE CONTROL",display=display.none)
type PulseOrderBlock
    float hi
    float lo
    int origin
    int born
    int finish
    int side
    int state
    int quality
var array<PulseOrderBlock> pulseBlocks=array.new<PulseOrderBlock>()
var array<box> pulseBlockBoxes=array.new<box>()
float obATR=ta.atr(obATRLength)
float obPH=ta.pivothigh(high,obStrength,obStrength)
float obPL=ta.pivotlow(low,obStrength,obStrength)
var float obSwingHigh=na
var float obSwingLow=na
var bool obHighBroken=false
var bool obLowBroken=false
var int obLastDemand=na
var int obLastSupply=na
float obPreviousLow=ta.lowest(low[1],obSweepWindow)
float obPreviousHigh=ta.highest(high[1],obSweepWindow)
bool obDemandSweep=low<obPreviousLow and close>obPreviousLow
bool obSupplySweep=high>obPreviousHigh and close<obPreviousHigh
int obDemandSweepAge=ta.barssince(obDemandSweep)
int obSupplySweepAge=ta.barssince(obSupplySweep)
bool obSmall=obStrictSmall and timeframe.in_seconds()<300
float obRequiredBody=obSmall ? math.max(obBodyMinimum,obSmallBody) : obBodyMinimum
int obRequiredSpacing=obSmall ? math.max(obSpacing,obSmallSpacing) : obSpacing
int obVisibleFresh=obSmall ? math.min(obFreshLimit,obSmallFresh) : obFreshLimit
if obEnabled and chart.is_standard and barstate.isconfirmed
    if array.size(pulseBlocks)>0
        for j=array.size(pulseBlocks)-1 to 0
            PulseOrderBlock z=array.get(pulseBlocks,j)
            if time-z.origin>obKeepDays*86400000
                array.remove(pulseBlocks,j)
            else if z.state!=2 and bar_index>z.born
                bool invalid=z.side==1 ? (obInvalidation=="Close" ? close<z.lo : low<z.lo) : (obInvalidation=="Close" ? close>z.hi : high>z.hi)
                bool touched=low<=z.hi and high>=z.lo
                if invalid
                    int priorState=z.state
                    z.state:=2
                    if not obFreeze or priorState==0
                        z.finish:=time_close
                else
                    if z.state==0 or not obFreeze
                        z.finish:=time_close
                    if touched and z.state==0
                        z.state:=1
    if not na(obPH)
        obSwingHigh:=obPH
        obHighBroken:=false
    if not na(obPL)
        obSwingLow:=obPL
        obLowBroken:=false
    bool demandBreak=not na(obSwingHigh) and not obHighBroken and close>obSwingHigh
    bool supplyBreak=not na(obSwingLow) and not obLowBroken and close<obSwingLow
    if demandBreak
        obHighBroken:=true
    if supplyBreak
        obLowBroken:=true
    int side=demandBreak ? 1 : supplyBreak ? -1 : 0
    float bodyATR=not na(obATR) and obATR>0 ? math.abs(close-open)/obATR : 0.0
    if side!=0 and bodyATR>=obRequiredBody
        bool swept=side==1 ? not na(obDemandSweepAge) and obDemandSweepAge<=obSweepWindow : not na(obSupplySweepAge) and obSupplySweepAge<=obSweepWindow
        bool aligned=side==1 ? close>sh : close<sl
        int quality=int(math.min(100,50+math.min(30,bodyATR*20)+(swept ? 10 : 0)+(aligned ? 10 : 0)))
        int previous=side==1 ? obLastDemand : obLastSupply
        bool spaced=na(previous) or bar_index-previous>=obRequiredSpacing
        if quality>=obMinimumScore and spaced and (not obStrictSweep or swept) and (not obSMAFilter or aligned)
            int originOffset=na
            for j=1 to obSearch
                bool opposite=side==1 ? close[j]<open[j] : close[j]>open[j]
                if opposite and na(originOffset)
                    originOffset:=j
            if not na(originOffset)
                float top=side==1 and obBoundary=="Body to wick" ? open[originOffset] : high[originOffset]
                float bottom=side==-1 and obBoundary=="Body to wick" ? open[originOffset] : low[originOffset]
                bool duplicate=false
                if array.size(pulseBlocks)>0
                    for z in pulseBlocks
                        if z.side==side and (z.origin==time[originOffset] or (z.state==0 and math.abs((z.hi+z.lo-top-bottom)*0.5)<=obATR*obNearATR))
                            duplicate:=true
                if not duplicate and top>bottom
                    array.push(pulseBlocks,PulseOrderBlock.new(top,bottom,time[originOffset],bar_index,time_close,side,0,quality))
                    if side==1
                        obLastDemand:=bar_index
                    else
                        obLastSupply:=bar_index
    while array.size(pulseBlocks)>obMaxHistory
        array.shift(pulseBlocks)
if barstate.islast
    for item in pulseBlockBoxes
        box.delete(item)
    array.clear(pulseBlockBoxes)
    if obEnabled and chart.is_standard and array.size(pulseBlocks)>0
        int demandShown=0
        int supplyShown=0
        int touchedShown=0
        int budget=math.min(obMaxHistory,math.max(0,480-array.size(box.all)))
        for j=array.size(pulseBlocks)-1 to 0
            PulseOrderBlock z=array.get(pulseBlocks,j)
            bool allowed=z.state==0 ? (z.side==1 ? demandShown<obVisibleFresh : supplyShown<obVisibleFresh) : z.state==1 ? touchedShown<obTouchedLimit : obShowInvalid
            float priceDistance=z.lo>close ? z.lo-close : z.hi<close ? close-z.hi : 0.0
            bool nearby=not obNearPrice or priceDistance<=obATR*obDistanceATR
            if allowed and nearby and array.size(pulseBlockBoxes)<budget
                color col=z.side==1 ? obDemandColor : obSupplyColor
                int transparency=z.state==0 ? obFreshTransparency : z.state==1 ? obTouchTransparency : obInvalidTransparency
                string state=z.state==0 ? "FRESH" : z.state==1 ? "TOUCHED" : "INVALID"
                string caption=obLabels and z.state!=2 ? (z.side==1 ? "DEMAND" : "SUPPLY")+" · "+state+" · Q"+str.tostring(z.quality) : ""
                int right=z.state==0 or (z.state==1 and not obFreeze) ? time_close : z.finish
                array.push(pulseBlockBoxes,box.new(z.origin,z.hi,right,z.lo,xloc=xloc.bar_time,border_color=color.new(col,z.state==0 ? 25 : z.state==1 ? 55 : 80),border_width=1,border_style=z.state==2 ? line.style_dashed : line.style_solid,bgcolor=color.new(col,transparency),text=caption,text_size=size.tiny,text_color=color.new(col,z.state==2 ? 35 : 0),text_halign=text.align_right,text_valign=z.side==1 ? text.align_bottom : text.align_top))
                if z.state==0
                    if z.side==1
                        demandShown+=1
                    else
                        supplyShown+=1
                else if z.state==1
                    touchedShown+=1
